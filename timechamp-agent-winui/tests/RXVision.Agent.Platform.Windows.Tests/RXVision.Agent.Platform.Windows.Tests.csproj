<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the parts of the Windows platform layer and the installer
       whose logic is testable without Windows: idle tick wraparound, sleep math,
       browser-host normalisation, app-name fallback, the exe config trailer, and the
       installer's swap and rollback. The Windows platform project is referenced for
       its internals (via InternalsVisibleTo). The installer's logic files are linked
       in as source, so the test never drags in the single-file win-x64 exe. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- These are test doubles and linked installer source; keep the RID neutral. -->
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RXVision.Agent.Platform.Windows/RXVision.Agent.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer logic as source (portable; no Windows-only API in these files). -->
    <Compile Include="../../packaging/windows/RXVision.Installer/InstallerCore.cs" Link="Installer/InstallerCore.cs" />
    <Compile Include="../../packaging/windows/RXVision.Installer/Trailer.cs" Link="Installer/Trailer.cs" />
  </ItemGroup>

</Project>
