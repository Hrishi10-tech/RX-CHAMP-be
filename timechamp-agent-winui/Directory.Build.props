<Project>
  <!-- Shared by every project in the agent solution. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- One version for the whole agent: the app, the installer and what the
         server is told. Bump it here; src/RXVision.Agent/app.manifest repeats it
         for Windows (a test fails while the two differ). -->
    <Version>4.1.0</Version>
    <Company>RX Vision</Company>
    <Product>RX Vision Agent</Product>
    <Copyright>RX Vision</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Security (S-1, 19 November 2026): this arrives through other packages at a version with
       a known advisory (System.Text.Json 8.0.4, GHSA-8g4q-xg66-9fp4), so every project names the
       fixed release itself. Remove the line when the package that brings it in moves on. -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
</Project>
