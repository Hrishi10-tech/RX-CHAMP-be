# dependencies
node_modules/

# build
dist/
build/

# env
.env
.env.local
.env.*.local
.env.example
# Catch-all so a new .env.<something> (e.g. .env.production, holding live JWT
# signing keys and DB credentials) can never be committed by accident.
.env.*

# logs
logs/
*.log
npm-debug.log*

# test coverage
coverage/

# IDE
.idea/
.vscode/
*.swp

# WebP sizes generated from the avatar masters by scripts/build-avatars.mjs
assets/avatars/webp/

# OS
.DS_Store
Thumbs.db

# prisma
prisma/*.db
# compiled seed output (seed.ts is the source; the .js is build junk)
prisma/seed.js
prisma/seed.d.ts
prisma/seed.js.map

# TypeScript incremental build cache
*.tsbuildinfo

# .NET build output (the desktop agent projects). Keeps their source, drops the
# ~1.1 GB of compiled artefacts — one of which is over GitHub's 100 MB hard limit.
[Bb]in/
[Oo]bj/
publish/
payload/
*.exe
*.dll
*.pdb

# Local-only folders (do not push to GitHub)
.github/*
!.github/workflows/
.husky/
docs/

# The desktop agent's build scripts (the build/ rule above is for compiled output)
!timechamp-agent-winui/build/

# Release run (Nov 2026): the kit, the delivery output, agent worktrees and the generated
# test environment never enter git.
rxvision-kit/
rxvision-delivery/
.worktrees/
.claude/worktrees/
.env.test
