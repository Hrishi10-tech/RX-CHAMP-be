<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:RXVision.Agent.ViewModels.Dialogs"
             xmlns:conv="using:RXVision.Agent.Converters"
             x:Class="RXVision.Agent.Views.ReasonDialogView"
             x:DataType="dlg:ReasonDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <!-- Screen D and the note screens: the question, what it costs, then the reason when one is asked for. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,26,20,20" Spacing="10">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Classes="lead" Text="{Binding Lead}" IsVisible="{Binding HasLead}" />
      <WrapPanel IsVisible="{Binding HasTag}">
        <Border Classes="pill" Background="{Binding TagTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}" Margin="0,0,8,0">
          <TextBlock Text="{Binding TagText}" Foreground="{Binding TagTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
        </Border>
        <TextBlock Classes="small" Text="{Binding TagDetail}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </WrapPanel>
      <TextBlock Classes="body" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
      <ItemsControl Name="ChipList" ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" AutomationProperties.Name="Quick reasons">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dlg:ChipViewModel">
            <Button Classes="chip small" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" Margin="0,0,6,6" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="6" IsVisible="{Binding AsksReason}">
        <TextBlock Classes="label" Text="{Binding Label}" />
        <TextBox Name="ReasonBox"
                 Classes="field"
                 Text="{Binding Text}"
                 Watermark="{Binding Placeholder}"
                 MaxLength="{Binding MaxLength}"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 Height="64"
                 VerticalContentAlignment="Top" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="small" Text="{Binding Hint}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Classes="count" Classes.ok="{Binding CountOk}" Text="{Binding CountText}" Margin="10,0,0,0" />
        </Grid>
      </StackPanel>
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="dialogfooter">
      <StackPanel Spacing="10">
        <!-- Ask manager, then Leave them out and Stay on break; or Start break, then Skip break and Cancel -->
        <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding PrimaryText}"
                Command="{Binding SubmitCommand}" IsDefault="{Binding HasAlt}" IsVisible="{Binding HasAlt}" />
        <Grid ColumnDefinitions="*,11,*" IsVisible="{Binding HasAlt}">
          <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding AltText}" Command="{Binding AlternativeCommand}" />
          <Button Grid.Column="2" Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,11,*" IsVisible="{Binding HasNoAlt}">
          <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
          <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Stretch" Content="{Binding PrimaryText}"
                  Command="{Binding SubmitCommand}" IsDefault="{Binding HasNoAlt}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
