<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RXVision.Agent.ViewModels"
        xmlns:views="using:RXVision.Agent.Views"
        xmlns:conv="using:RXVision.Agent.Converters"
        x:Class="RXVision.Agent.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Title="RX Vision"
        Icon="avares://RXVision/Assets/rxvision.ico"
        Width="340" Height="540"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

  <Window.Resources>
    <!-- Today's actions, outlined (4.0's actions in the 3.6 panel's look): Next break (the next
         scheduled break, or resume a paused one) and Quick break, then Start meeting, then the
         4.0 meeting dialog with its agenda and people, which also logs an earlier meeting. -->
    <DataTemplate x:Key="ActionsTemplate" x:DataType="vm:DashboardViewModel">
      <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,0,10" IsVisible="{Binding ShowBreakActions}">
          <Button Name="NextBreakAction" Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding NextTile.Title}" Command="{Binding NextTile.Command}"
                  ToolTip.Tip="{Binding NextTile.ToolTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding NextTile.Title}" />
          <TextBlock Classes="small" Text="{Binding NextTile.Caption}" TextAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="{Binding NextTile.ToolTip}" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,10" IsVisible="{Binding ShowBreakActions}">
          <Button Name="QuickBreakAction" Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding QuickTile.Title}" Command="{Binding QuickTile.Command}"
                  ToolTip.Tip="{Binding QuickTile.ToolTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding QuickTile.Title}" />
          <TextBlock Classes="small" Text="{Binding QuickTile.Caption}" TextAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="{Binding QuickTile.ToolTip}" />
        </StackPanel>
        <Button Grid.Row="1" Grid.ColumnSpan="3" Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding MeetingTile.Title}"
                Command="{Binding MeetingTile.Command}" ToolTip.Tip="{Binding MeetingTile.ToolTip}" ToolTip.ShowOnDisabled="True"
                IsVisible="{Binding ShowPanelStartMeeting}" AutomationProperties.Name="{Binding MeetingTile.Title}" />
        <Button Grid.Row="2" Grid.ColumnSpan="3" Classes="quiet" Margin="0,8,0,0" Content="Meeting with details, or an earlier one" Command="{Binding RecordMeetingCommand}"
                IsVisible="{Binding ShowTiles}" AutomationProperties.Name="Meeting with details, or an earlier one" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- The panel (be/docs/3.6/AGENT.md section 4): 340 x 540, one column of 298 px between 20 px gutters. -->
  <Border Classes="panelframe" ClipToBounds="True">
    <Panel>
      <Grid Name="Body" RowDefinitions="58,*,Auto" IsEnabled="{Binding !HasOverlay}">

        <!-- ===== Header: the product, the tabs, close ===== -->
        <Grid Margin="20,4,16,0" ColumnDefinitions="*,Auto,Auto">
          <TextBlock Classes="product" Text="RX Vision" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,10,0" VerticalAlignment="Center">
            <Button Classes="paneltab" Classes.on="{Binding IsTodayTab}" Content="Today" Command="{Binding ShowDashboardCommand}" />
            <Button Classes="paneltab" Classes.on="{Binding IsMessagesTab}" Content="Messages" Command="{Binding ShowMessagesCommand}" />
            <Button Classes="paneltab" Classes.on="{Binding IsProfileTab}" Content="Profile" Command="{Binding ShowProfileCommand}" />
          </StackPanel>
          <Button Name="CloseButton" Grid.Column="2" Classes="ghost" VerticalAlignment="Center"
                  ToolTip.Tip="Close" AutomationProperties.Name="Close">
            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource Brush.TextQuiet}" StrokeThickness="1.5" StrokeLineCap="Round"
                  Width="8" Height="8" Margin="3" />
          </Button>
        </Grid>

        <!-- ===== Today ===== -->
        <ScrollViewer Grid.Row="1" Name="TodayScroll" IsVisible="{Binding IsTodayTab}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,16">

            <!-- Screen E: two minutes before a break ends -->
            <Border Classes="alertcard" Margin="0,0,0,18" IsVisible="{Binding ActiveBreak.EndsSoon}">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="iconcircle amber">
                    <TextBlock Text="i" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardtitle" Text="Break ends in 2 min" />
                    <TextBlock Classes="cardbody" Text="Your ring starts again when you resume." />
                  </StackPanel>
                </Grid>
                <Button Name="ResumeNow" Classes="primary" HorizontalAlignment="Stretch" Content="Resume now"
                        Command="{Binding BackToWorkCommand}" Margin="0,0,0,4" />
              </StackPanel>
            </Border>

            <!-- Screen A: break due -->
            <Border Classes="alertcard" Margin="0,0,0,18" IsVisible="{Binding BreakDue.IsShown}">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="iconcircle">
                    <PathIcon Classes="i" Data="{StaticResource Icon.Coffee}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardtitle" Text="{Binding BreakDue.Title}" />
                    <TextBlock Classes="cardbody" Text="{Binding BreakDue.Detail}" />
                  </StackPanel>
                </Grid>
                <Button Name="TakeBreakNow" Classes="primary" HorizontalAlignment="Stretch" Margin="0,14,0,0" Content="Take a break"
                        Command="{Binding BreakDue.TakeCommand}" />
                <Button Classes="quiet" Margin="0,6,0,0" Content="Skip this break" Command="{Binding BreakDue.SkipCommand}"
                        IsVisible="{Binding BreakDue.CanSkip}" />
              </StackPanel>
            </Border>

            <!-- Skipped for you: a comment before the day can end -->
            <Border Classes="alertcard" Margin="0,0,0,18" IsVisible="{Binding HasCommentCard}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="iconcircle amber">
                    <PathIcon Classes="i" Data="{StaticResource Icon.Coffee}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardtitle" Text="{Binding CommentCardTitle}" />
                    <TextBlock Classes="cardbody" Text="Add a comment before you end your day." />
                  </StackPanel>
                </Grid>
                <Button Name="CommentNow" Classes="secondary" HorizontalAlignment="Stretch" Content="Add comment"
                        Command="{Binding AddCommentFromCardCommand}" Margin="0,0,0,4" />
              </StackPanel>
            </Border>

            <!-- Every other alert: "!" before "i", then newest first -->
            <views:AlertCardsView Name="AlertCards" />

            <!-- What the day view says, and what the agent itself needs -->
            <StackPanel Spacing="10" Margin="0,0,0,14" IsVisible="{Binding HasNotes}">
              <Border Classes="banner" IsVisible="{Binding DayOffText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="muted" Text="{Binding DayOffText}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="banner" IsVisible="{Binding LeaveText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="muted" Text="{Binding LeaveText}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="banner" IsVisible="{Binding WfhText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="muted" Text="{Binding WfhText}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="banner" IsVisible="{Binding CheckoutMissingText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="muted" Text="{Binding CheckoutMissingText}" TextWrapping="Wrap" />
              </Border>
              <!-- A late start made elsewhere still wants its note -->
              <Border Classes="banner warn" IsVisible="{Binding LateReasonText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="cardbody" Text="{Binding LateReasonText}" />
                  <Button Classes="secondary" HorizontalAlignment="Stretch" Content="Add the note" Command="{Binding AddLateReasonCommand}" />
                </StackPanel>
              </Border>
              <Border Classes="banner warn" IsVisible="{Binding ShowScreenRecordingBanner}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="title" Text="Allow screen recording for RX Vision" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding DismissScreenRecordingCommand}" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
                      <PathIcon Classes="i" Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="cardbody" Text="Turn on screen recording for RX Vision. After allowing it, quit and reopen RX Vision." />
                  <Button Classes="secondary" HorizontalAlignment="Stretch" Content="Allow screen recording" Command="{Binding AllowScreenRecordingCommand}" />
                </StackPanel>
              </Border>
              <Border Classes="banner" IsVisible="{Binding HasUpdate}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="cardbody" Text="{Binding UpdateText}" />
                    <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0" Command="{Binding DismissUpdateCommand}" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Top">
                      <PathIcon Classes="i" Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                  </Grid>
                  <Button Classes="soft" HorizontalAlignment="Stretch" Content="{Binding DownloadLabel}" Command="{Binding DownloadUpdateCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Screens B, C and F: on a break, the break extended, a break with no length.
                 The status block keeps its place and its 64 px ring: the ring's clock carries the
                 break (amber through the break's section; past its closing gap, run over) and the
                 focus time beside it shows Paused. No countdown. -->
            <StackPanel IsVisible="{Binding IsOnBreak}">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,16">
                <Ellipse Classes="statusdot" Fill="{StaticResource Brush.Amber}" />
                <TextBlock Classes="status" Text="{Binding ActiveBreak.StatusText}" />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <views:PanelIcon Name="BreakRing" State="{Binding BreakIcon}" Avatars="{Binding IconAvatars}" Width="64" Height="64"
                                 AutomationProperties.Name="{Binding ActiveBreak.RingName}" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="progressline" VerticalAlignment="Center" Text="{Binding ActiveBreak.PausedLine}" />
                    <Border Classes="pausedpill" VerticalAlignment="Center">
                      <TextBlock Text="Paused" />
                    </Border>
                  </StackPanel>
                  <TextBlock Name="BreakWindow" Classes="muted" Text="{Binding ActiveBreak.WindowLine}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="4" Margin="0,16,0,0">
                <TextBlock Classes="small" Text="{Binding ActiveBreak.TimingLine}" TextWrapping="Wrap"
                           IsVisible="{Binding ActiveBreak.TimingLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="small" Text="{Binding ActiveBreak.Approval}" TextWrapping="Wrap"
                           IsVisible="{Binding ActiveBreak.Approval, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="small" Text="{Binding ActiveBreak.ExtraMinutes}" TextWrapping="Wrap"
                           IsVisible="{Binding ActiveBreak.ExtraMinutes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- 4.0: what the break costs (the paid buffer), a quick break's plan, an away break -->
                <TextBlock Name="BreakNote" Classes="small" Text="{Binding ActiveBreak.Note}" TextWrapping="Wrap" />
                <TextBlock Classes="small" Text="{Binding ActiveBreak.Started}" TextWrapping="Wrap" />
              </StackPanel>
              <!-- 4.0: a scheduled break can be paused (focus time starts again; resume it from Next break) -->
              <Button Name="PauseBreakButton" Classes="secondary" HorizontalAlignment="Stretch" Margin="0,14,0,0" Content="Pause break"
                      Command="{Binding PauseBreakCommand}" IsVisible="{Binding ActiveBreak.CanPause}" AutomationProperties.Name="Pause break"
                      ToolTip.Tip="Pause: your focus time starts again. Resume before the break's window closes." />
            </StackPanel>

            <!-- In a meeting: the status line, Started, End meeting. A meeting recorded with its details (4.0's dialog) also shows its agenda, people and minutes -->
            <StackPanel Spacing="8" IsVisible="{Binding IsInMeeting}" Margin="0,8,0,18">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="statusdot" Fill="{StaticResource Brush.Meeting}" />
                <TextBlock Classes="status" Text="In a meeting" />
              </StackPanel>
              <TextBlock Classes="muted" Text="{Binding MeetingStarted}" />
              <TextBlock Classes="sofar" Text="{Binding MeetingTimer}" />
              <TextBlock Classes="title" Text="{Binding MeetingAgenda}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding MeetingAgenda, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding MeetingPeopleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <ItemsControl ItemsSource="{Binding MeetingPeople}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MeetingPersonViewModel">
                      <!-- The avatar seam: initials until the avatars stream draws the person's picture -->
                      <Border Classes="avatar" Width="24" Height="24" Margin="0,0,-6,0" ToolTip.Tip="{Binding Name}">
                        <TextBlock Text="{Binding Initials}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="1" Classes="small" Margin="14,0,0,0" Text="{Binding MeetingPeopleText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
              <TextBlock Classes="small" Text="{Binding MeetingMomText}" IsVisible="{Binding MeetingMomText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="small" Text="Your focus time keeps counting in a meeting." />
              <!-- 4.0: a break waits for End meeting (the day's own rule), so no break buttons here -->
              <Button Name="EndMeetingButton" Classes="primary" HorizontalAlignment="Stretch" Margin="0,6,0,0" Content="End meeting" Command="{Binding EndMeetingCommand}"
                      IsVisible="{Binding ShowPanelEndMeeting}" AutomationProperties.Name="End meeting" />
            </StackPanel>

            <!-- Not started: the day begins with this button -->
            <StackPanel Spacing="10" IsVisible="{Binding IsNotStarted}" Margin="0,4,0,18">
              <TextBlock Classes="muted" Text="Your day hasn't started" />
              <TextBlock Classes="greeting" Text="{Binding GreetingText}" IsVisible="{Binding ShowGreeting}" />
              <TextBlock Classes="muted" Text="{Binding ShiftLine}" TextWrapping="Wrap" IsVisible="{Binding ShiftLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button Name="StartDayButton" Classes="primary" HorizontalAlignment="Stretch" Margin="0,6,0,0" Command="{Binding StartDayCommand}"
                      IsVisible="{Binding ShowStartDayButton}" AutomationProperties.Name="Start day" Content="{Binding StartDayLabel}" />
              <TextBlock Classes="small" Text="Nothing is recorded until you tap Start day." TextWrapping="Wrap" IsVisible="{Binding ShowDayButtons}" />
              <Border Classes="note" IsVisible="{Binding IsBiometric}">
                <TextBlock Text="{Binding BiometricText}" TextWrapping="Wrap" FontSize="13" />
              </Border>
              <Border Classes="note" IsVisible="{Binding DayCheckText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding DayCheckText}" TextWrapping="Wrap" FontSize="13" />
              </Border>
              <Border Classes="note" IsVisible="{Binding LastEndedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding LastEndedText}" TextWrapping="Wrap" FontSize="13" />
              </Border>
            </StackPanel>

            <!-- Day ended -->
            <StackPanel Spacing="10" IsVisible="{Binding IsDayEnded}" Margin="0,4,0,18">
              <TextBlock Classes="cardtitle" Text="{Binding EndedTitle}" />
              <TextBlock Classes="muted" Text="{Binding EndedDetail}" TextWrapping="Wrap" />
              <!-- Outlined: the day is over, so starting again is the exception, never the obvious tap -->
              <Button Name="RestartDayButton" Classes="secondary" HorizontalAlignment="Stretch" Margin="0,6,0,0" Content="Start day" Command="{Binding StartDayCommand}"
                      IsVisible="{Binding ShowDayButtons}" AutomationProperties.Name="Start day" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowDayDetails}">
              <!-- The status line, on the plain screen -->
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,16" IsVisible="{Binding ShowStatusLine}">
                <Ellipse Classes="statusdot" Fill="{Binding StatusKind, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
                <TextBlock Classes="status" Text="{Binding StatusText}" />
              </StackPanel>
              <!-- Screen A's divider -->
              <Border Classes="divider" Margin="0,0,0,18" IsVisible="{Binding BreakDue.IsShown}" />

              <!-- Today's progress -->
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <views:PanelIcon Name="DayRing" State="{Binding Icon}" Avatars="{Binding IconAvatars}" Width="64" Height="64"
                                 AutomationProperties.Name="{Binding RingName}" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="progressline" Text="{Binding Today.ProgressLine}" />
                  <TextBlock Classes="muted" Text="{Binding Today.ToGoLine}" IsVisible="{Binding Today.ToGoLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>

              <!-- Actions, on the plain screen -->
              <ContentControl Margin="0,10,0,0" Content="{Binding}" ContentTemplate="{StaticResource ActionsTemplate}" IsVisible="{Binding ShowActionsAbove}" />

              <!-- Today's breaks -->
              <StackPanel IsVisible="{Binding ShowBreakList}" Margin="0,16,0,0">
                <TextBlock Classes="muted" Text="Today's breaks" Margin="0,0,0,4" />
                <TextBlock Classes="small" Text="{Binding ShiftText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                           IsVisible="{Binding !BreakDue.IsShown}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreakRowViewModel">
                      <Border Classes="breakrow" AutomationProperties.Name="{Binding SpokenText}" ToolTip.Tip="{Binding Detail}">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="rowname" Classes.current="{Binding IsCurrent}" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="rowright" Margin="8,0,0,0" Text="{Binding RightText}" IsVisible="{Binding ShowRightText}" />
                            <Border Grid.Column="1" Classes="nowpill" Margin="8,0,0,0" IsVisible="{Binding IsCurrent}">
                              <TextBlock Text="Now" />
                            </Border>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowChips}">
                            <Border Classes="pill" IsVisible="{Binding ShowTiming}" Background="{Binding PillTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}">
                              <TextBlock Text="{Binding PillText}" Foreground="{Binding PillTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
                            </Border>
                            <Border Classes="pill" IsVisible="{Binding HasApproval}" Background="{Binding ApprovalTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}">
                              <TextBlock Text="{Binding ApprovalText}" Foreground="{Binding ApprovalTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="small" Classes.attention="{Binding DetailIsAlert}" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding ShowDetail}" />
                          <TextBlock Classes="small" Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic" IsVisible="{Binding HasNote}" />
                          <Button Classes="link" Content="Add comment" Command="{Binding CommentCommand}" HorizontalAlignment="Left"
                                  Margin="0,2,0,2" IsVisible="{Binding CanComment}" AutomationProperties.Name="Add comment" />
                          <!-- 4.0: a paused break can be resumed inside its window, or ended -->
                          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,2" IsVisible="{Binding HasActions}">
                            <Button Classes="link" Content="Resume" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" AutomationProperties.Name="Resume break" />
                            <Button Classes="link" Content="End break" Command="{Binding EndCommand}" IsVisible="{Binding CanEnd}" AutomationProperties.Name="End break" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" Text="{Binding FreeText}" TextWrapping="Wrap" IsVisible="{Binding ShowFreeText}" LineHeight="18" />
              </StackPanel>

              <!-- Actions, under a card: its one primary action comes first -->
              <ContentControl Margin="0,16,0,0" Content="{Binding}" ContentTemplate="{StaticResource ActionsTemplate}" IsVisible="{Binding ShowActionsBelow}" />

              <!-- Time taken today -->
              <StackPanel Spacing="8" Margin="0,18,0,0">
                <TextBlock Classes="muted" Text="Time taken today" />
                <Grid ColumnDefinitions="*,*,*">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="small" Text="Break" />
                    <TextBlock Classes="title num" FontSize="14" Text="{Binding Today.BreakTotal}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="small" Text="Lunch" />
                    <TextBlock Classes="title num" FontSize="14" Text="{Binding Today.LunchTotal}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Classes="small" Text="Meeting" />
                    <TextBlock Classes="title num" FontSize="14" Text="{Binding Today.MeetingTotal}" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- Focus time: the server's number, ticking while the day runs -->
              <StackPanel Spacing="4" Margin="0,18,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="muted" Text="Focus time" />
                  <TextBlock Grid.Column="1" Classes="small" Text="{Binding Today.ExpectedText}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="title num" FontSize="14" Text="{Binding Today.FocusText}" />
                <TextBlock Classes="small" Text="{Binding Today.FocusStatus}" TextWrapping="Wrap" />
                <TextBlock Classes="small" Text="{Binding Today.DayStartedText}" IsVisible="{Binding Today.DayStartedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="small" Text="{Binding Today.PlusText}" IsVisible="{Binding Today.HasPlus}" />
                <TextBlock Classes="small" Text="{Binding Today.MinusText}" IsVisible="{Binding Today.HasMinus}" />
                <TextBlock Classes="small" Text="{Binding Today.AdjustedText}" IsVisible="{Binding Today.HasAdjusted}" TextWrapping="Wrap" />
                <TextBlock Classes="small" Text="Focus time runs from Start day, minus breaks" TextWrapping="Wrap" />
              </StackPanel>

              <!-- 4.0: the paid break allowance (SPEC 2.4, 8.1), paid time (focus + paid breaks), and
                   offline time the server has no activity data for yet (only when there is some) -->
              <StackPanel Spacing="4" Margin="0,18,0,0">
                <TextBlock Name="AllowanceLine" Classes="small" Classes.attention="{Binding Today.HasUnpaid}" Text="{Binding Today.AllowanceText}"
                           TextWrapping="Wrap" ToolTip.Tip="{Binding Today.AllowanceToolTip}" />
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Today.HasPaidTime}" Background="Transparent" ToolTip.Tip="{x:Static vm:TodayViewModel.PaidTimeToolTip}">
                  <TextBlock Classes="muted" Text="Paid time" />
                  <TextBlock Grid.Column="1" Classes="title num" FontSize="14" Text="{Binding Today.PaidTimeText}" />
                </Grid>
                <Border Classes="note" IsVisible="{Binding Today.HasUnverified}">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Offline, no activity data" />
                      <TextBlock Classes="num" FontWeight="SemiBold" Text="{Binding Today.UnverifiedText}" />
                    </StackPanel>
                    <TextBlock Classes="small" TextWrapping="Wrap" Text="{x:Static vm:TodayViewModel.UnverifiedNote}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Waiting for your manager -->
              <StackPanel Spacing="6" Margin="0,18,0,0" IsVisible="{Binding Today.HasWaiting}">
                <TextBlock Classes="muted" Text="{Binding Today.WaitingTitle}" />
                <ItemsControl ItemsSource="{Binding Today.Waiting}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WaitingItemViewModel">
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,8" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding Kind, Converter={x:Static conv:WaitingDotConverter.Instance}}" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="1" Classes="pill" Margin="8,3,0,0" HorizontalAlignment="Left"
                                Background="{Binding ChipTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}">
                          <TextBlock Text="{Binding Chip}" Foreground="{Binding ChipTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="small" Text="{Binding Today.WaitingMore}" IsVisible="{Binding Today.WaitingMore, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>

              <!-- End day: a quiet text action -->
              <Button Classes="quiet" Margin="0,16,0,0" Content="End day" Command="{Binding EndDayCommand}" IsVisible="{Binding ShowEndDay}" />

              <!-- The sync line -->
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" Margin="0,12,0,0"
                          IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{Binding SyncTone, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
                <TextBlock Classes="small" Text="{Binding SyncText}" ToolTip.Tip="{Binding SyncToolTip}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding IsBusy}">
                <PathIcon Classes="spinner" Width="14" Height="14" />
                <TextBlock Classes="small" Text="Saving..." VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Resume work: where the design puts it, at the foot of the panel -->
        <Button Grid.Row="2" Name="ResumeWork" Classes="primary" Margin="20,12,20,19" HorizontalAlignment="Stretch" Content="Resume work"
                Command="{Binding BackToWorkCommand}" AutomationProperties.Name="Resume work" IsVisible="{Binding ShowResume}" />

        <!-- ===== Messages ===== -->
        <views:ChatView Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding Chat}"
                        IsVisible="{Binding $parent[Window].((vm:DashboardViewModel)DataContext).IsMessagesTab}" />

        <!-- ===== Profile ===== -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowProfileList}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,16">
            <!-- The account. The avatar seam: initials here until the avatars stream draws the picture
                 and makes this row open the picker (D-85). -->
            <Border Name="Account" Margin="0,0,0,8" Padding="0,8" AutomationProperties.Name="Account">
              <Grid ColumnDefinitions="Auto,*">
                <Border Classes="avatar" Width="44" Height="44" CornerRadius="22" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Initials}" FontSize="15" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="status" Text="{Binding DisplayName}" MaxWidth="230" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" Text="{Binding StatusText}" />
                  <TextBlock Classes="small" Text="{Binding DepartmentText}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding DepartmentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="divider" Margin="0,0,0,6" />
            <Button Classes="menuitem" Command="{Binding ShowHistoryCommand}" AutomationProperties.Name="History">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="i" Data="{StaticResource Icon.History}" Width="17" Height="17" />
                <TextBlock Text="History" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="menuitem" Command="{Binding ShowInstructionsCommand}" AutomationProperties.Name="Instructions">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="i" Data="{StaticResource Icon.Book}" Width="17" Height="17" />
                <TextBlock Text="Instructions" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="menuitem" Command="{Binding ShowCalendarCommand}" AutomationProperties.Name="My calendar">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="i" Data="{StaticResource Icon.Calendar}" Width="17" Height="17" />
                <TextBlock Text="My calendar" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="menuitem" Command="{Binding ShowLeaveCommand}" AutomationProperties.Name="Leave">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="i" Data="{StaticResource Icon.Home}" Width="17" Height="17" />
                <TextBlock Text="Leave" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Classes="divider" Margin="0,6" />
            <!-- 4.0: sign out takes a key from the admin; only admins quit, with a key -->
            <Button Classes="menuitem" Command="{Binding SignOutCommand}" AutomationProperties.Name="Sign out">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="i" Data="{StaticResource Icon.SignOut}" Width="17" Height="17" />
                <StackPanel Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="Sign out…" />
                  <TextBlock Classes="small" Text="Needs a key from your admin" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="menuitem" Command="{Binding QuitCommand}" IsVisible="{Binding CanQuit}" AutomationProperties.Name="Quit RX Vision">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="i" Data="{StaticResource Icon.Power}" Width="17" Height="17" />
                <TextBlock Text="Quit RX Vision…" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- Who and what this is, for a support call -->
            <StackPanel Spacing="2" Margin="4,18,0,0">
              <TextBlock Classes="small" Text="{Binding ShiftText}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding ShiftText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="small" Text="{Binding VersionText}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- History, Leave, My calendar and Instructions, from the Profile tab -->
        <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto,*" IsVisible="{Binding !IsDashboardPage}">
          <Button Classes="ghost" Margin="15,0,0,6" HorizontalAlignment="Left" Command="{Binding ShowProfileCommand}"
                  ToolTip.Tip="Back" AutomationProperties.Name="Back">
            <PathIcon Classes="i" Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16" />
          </Button>
          <views:LeaveView Grid.Row="1" Margin="20,0,20,16" DataContext="{Binding Leave}" IsVisible="{Binding $parent[Window].((vm:DashboardViewModel)DataContext).IsLeavePage}" />
          <views:CalendarView Grid.Row="1" Margin="20,0,20,16" DataContext="{Binding Calendar}" IsVisible="{Binding $parent[Window].((vm:DashboardViewModel)DataContext).IsCalendarPage}" />
          <views:HistoryView Grid.Row="1" Margin="20,0,20,16" DataContext="{Binding History}" IsVisible="{Binding $parent[Window].((vm:DashboardViewModel)DataContext).IsHistoryPage}" />
          <views:InstructionsView Grid.Row="1" Margin="20,0,20,16" DataContext="{Binding Instructions}" IsVisible="{Binding $parent[Window].((vm:DashboardViewModel)DataContext).IsInstructionsPage}" />
        </Grid>
      </Grid>

      <!-- ===== Cards over the panel, which waits behind a scrim ===== -->
      <Panel IsVisible="{Binding HasOverlay}" Background="{StaticResource Brush.Scrim}">
        <Border Classes="dialogcard" Width="{Binding OverlayWidth}" MaxHeight="538" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ContentControl Content="{Binding Overlay}" />
        </Border>
      </Panel>
    </Panel>
  </Border>
</Window>
