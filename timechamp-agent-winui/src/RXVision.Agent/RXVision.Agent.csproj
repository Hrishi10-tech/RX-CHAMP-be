<Project Sdk="Microsoft.NET.Sdk">

  <!-- The RX Vision desktop app: tray or menu-bar icon, floating button, dashboard,
       sign-in, notice, toasts. One Avalonia codebase for Windows and macOS; all the
       agent's logic lives in RXVision.Agent.Core, the OS seams in the platform
       projects (picked at runtime in PlatformFactory). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RXVision</AssemblyName>
    <RootNamespace>RXVision.Agent</RootNamespace>
    <ApplicationIcon>Assets/rxvision.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia and the views use reflection-free compiled bindings, but trimming is
         not verified for this app: publish untrimmed. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The preset avatars: PNG masters here (committed), the WebP sizes generated into
         obj/ on every build and publish (never committed). -->
    <AvatarLibraryDir Condition="'$(AvatarLibraryDir)' == ''">$(MSBuildProjectDirectory)/Assets/avatars</AvatarLibraryDir>
    <AvatarBundleOut>$(MSBuildProjectDirectory)/obj/avatars</AvatarBundleOut>
    <AvatarBundleTool>$(MSBuildProjectDirectory)/../../build/avatars/AvatarBundle/bin/RXVision.AvatarBundle.dll</AvatarBundleTool>
    <AvatarDotnet>$(DOTNET_HOST_PATH)</AvatarDotnet>
    <AvatarDotnet Condition="'$(AvatarDotnet)' == ''">dotnet</AvatarDotnet>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linux desktop only, brought in by Avalonia at 0.20.0 (GHSA-xrw6-gwf8-vvr9): the fixed release, named here (S-1). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RXVision.Agent.Core/RXVision.Agent.Core.csproj" />
  </ItemGroup>

  <!-- The OS implementations. `-p:RxvNoPlatforms=true` builds the UI without them
       (DevPlatform only), for working on screens while those projects are mid-change. -->
  <ItemGroup Condition="'$(RxvNoPlatforms)' != 'true'">
    <ProjectReference Include="../RXVision.Agent.Platform.Windows/RXVision.Agent.Platform.Windows.csproj" />
    <ProjectReference Include="../RXVision.Agent.Platform.Mac/RXVision.Agent.Platform.Mac.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(RxvNoPlatforms)' == 'true'">
    <DefineConstants>$(DefineConstants);RXV_NO_PLATFORMS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded for the views (avares://RXVision/Assets/...). -->
    <AvaloniaResource Include="Assets/agent-badge.png;Assets/rxvision.ico;Assets/rxvision-256.png;Assets/tray.ico;Assets/tray.png;Assets/tray-template.png" />
    <!-- Beside the app for the installers: the icons are for packaging. -->
    <Content Include="Assets/rxvision.ico;Assets/rxvision-256.png;Assets/tray-template.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RXVision.Agent.UI.Tests" />
  </ItemGroup>

  <!-- Built for the machine doing the build, whatever runtime is being published. -->
  <ItemGroup>
    <ProjectReference Include="../../build/avatars/AvatarBundle/RXVision.AvatarBundle.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;UseAppHost;OutputPath;PublishDir;_CommandLineDefinedRuntimeIdentifier;_CommandLineDefinedSelfContained;_CommandLineDefinedOutputPath" />
  </ItemGroup>

  <!-- Masters to bundle, before anything is copied: a missing master fails the build, in
       Debug and in publish, for every runtime. The files go beside the app as Content, so
       an avatar is read from disk only when it is drawn. -->
  <Target Name="GenerateAvatarBundle" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <Exec Command="&quot;$(AvatarDotnet)&quot; &quot;$(AvatarBundleTool)&quot; &quot;$(AvatarLibraryDir)&quot; &quot;$(AvatarBundleOut)&quot;" StandardOutputImportance="low" />
    <ItemGroup>
      <_AvatarBundleFile Include="$(AvatarBundleOut)/bundle/**/*" />
      <Content Include="@(_AvatarBundleFile)" Link="Assets/avatars/%(_AvatarBundleFile.RecursiveDir)%(_AvatarBundleFile.Filename)%(_AvatarBundleFile.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
