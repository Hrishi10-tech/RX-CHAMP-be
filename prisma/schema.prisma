generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 4.0: Super Admin (platform) -> Admin (one organisation) -> Manager (one or more
// departments) -> Staff (USER, one department). ADMIN was folded into MANAGER by
// 20261013 and returns in 4.0 with the organisation-admin meaning.
enum RoleName {
  SUPER_ADMIN
  MANAGER
  USER
  ADMIN
  // 3.3: one person who oversees every organisation (read, approve, adjust focus).
  SUPER_MANAGER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// A non-working presence status an employee can be in during the day.
// "Working" is the implicit default — it's simply the absence of an open session.
enum PresenceType {
  BREAK
  LUNCH
  MEETING
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  // Granted permission codes, stored inline (validated against the Permission enum in code).
  permissions String[] @default([])
  users       User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

/// An organisation (4.0). The table keeps its 2.x name.
model Company {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  users                       User[]
  shifts                      Shift[]
  departments                 Department[]
  calendarDays                CalendarDay[]
  signOutKeys                 SignOutKey[]
  monthLocks                  MonthLock[]
  reportRuns                  ReportRun[]
  /// 3.6: when this organisation's biometric integration was on (the payroll pause).
  biometricIntegrationPeriods BiometricIntegrationPeriod[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("companies")
}

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  name      String
  // "HH:MM" 24h window, judged against attendance. end <= start means the shift
  // runs past midnight.
  start     String
  end       String
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  users     User[]

  /// ISO weekdays the shift works (1 = Monday ... 7 = Sunday).
  workDays        Int[]   @default([1, 2, 3, 4, 5, 6]) @map("work_days")
  /// The shift used when neither the person nor their department has one.
  isDefault       Boolean @default(false) @map("is_default")
  /// The agent starts ringing this many minutes before each break...
  ringLeadMin     Int     @default(1) @map("ring_lead_min")
  /// ...and rings for this long. Starting a break while it rings is "on time".
  ringDurationMin Int     @default(5) @map("ring_duration_min")
  /// Unread and unwritten since 3.6: no alert makes a sound (brief 1.2). Every answer says false.
  ringSound       Boolean @default(true) @map("ring_sound")
  /// Whether starting early (window open, before the ring) needs a reason.
  reasonOnEarly   Boolean @default(true) @map("reason_on_early")
  /// Whether starting late (after the ring, window still open) needs a reason.
  reasonOnLate    Boolean @default(true) @map("reason_on_late")
  reasonMinChars  Int     @default(10) @map("reason_min_chars")
  /// Also ask for a reason when someone comes back later than the grace allows.
  overrunReason   Boolean @default(false) @map("overrun_reason")
  /// Minutes over a break that are simply break time (no approval). 3.1 default 3.
  overrunGraceMin Int     @default(3) @map("overrun_grace_min")

  breaks           ShiftBreak[]
  assignments      ShiftAssignment[]
  departmentShifts DepartmentShift[]
  breakRecords     BreakRecord[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([companyId])
  @@map("shifts")
}

// The three daily breaks a shift can define.
enum BreakKind {
  MORNING
  LUNCH
  EVENING
  /// 4.0: a quick break, any time of the shift (5, 10 or 15 minutes planned).
  QUICK
}

/// 4.0: a break can be paused and resumed inside its window.
enum BreakState {
  ACTIVE
  PAUSED
  ENDED
}

/// 4.0 away (input) tracking: what became of a stretch with no keyboard or mouse input.
///   UNEXPLAINED   no reason given (End Day with the pop-up open, or not answered)
///   PENDING       a reason that needs approval to count as focus time
///   APPROVED / REJECTED  decided
///   NOT_REQUIRED  kept for history only
enum AwayStatus {
  UNEXPLAINED
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum SignOutScope {
  USERS
  DEPARTMENTS
  ORG
}

// How a break's start compares with its schedule.
//   ON_TIME         started while the agent was ringing
//   EARLY / LATE    started inside the allowed window but outside the ring
//   OUTSIDE_WINDOW  started outside the allowed window (only older agents can)
//   UNSCHEDULED     no matching scheduled break (older agents, or no shift)
enum BreakTiming {
  ON_TIME
  EARLY
  LATE
  OUTSIDE_WINDOW
  UNSCHEDULED
}

enum BreakApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ShiftAssignmentTarget {
  DEPARTMENT
  USER
}

/// One of a shift's breaks: when it is due, how long it lasts and the window in
/// which it may be started.
model ShiftBreak {
  id              String    @id @default(uuid()) @db.Uuid
  shiftId         String    @map("shift_id") @db.Uuid
  shift           Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  kind            BreakKind
  enabled         Boolean   @default(true)
  /// "HH:MM", local business time.
  startTime       String    @map("start_time")
  durationMin     Int       @map("duration_min")
  windowBeforeMin Int       @default(30) @map("window_before_min")
  windowAfterMin  Int       @default(60) @map("window_after_min")
  /// Whether staff may skip this break (3.1). The migration sets LUNCH rows to false.
  allowSkip       Boolean   @default(true) @map("allow_skip")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shiftId, kind])
  @@map("shift_breaks")
}

// What became of a scheduled break (3.1).
//   TAKEN         a break was taken (the 3.0 meaning of every record)
//   SKIPPED       the person pressed Skip break while the window was open
//   AUTO_SKIPPED  the window closed (or End Day ran inside it) with nothing taken
enum BreakOutcome {
  TAKEN
  SKIPPED
  AUTO_SKIPPED
}

enum MeetingMode {
  LIVE
  PAST
}

enum WorkSessionEndReason {
  USER
  AUTO_CLOSED
}

/// One stretch of a working day, Start Day to End Day (3.1). A day can hold several
/// (End Day then Start Day resumes). At most one is open per person: enforced by a
/// row lock on the user and by the partial unique index
/// work_sessions_one_open_per_user (migration SQL only; Prisma cannot express it).
model WorkSession {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Business-timezone day of startedAt. A session running past midnight keeps it.
  date         String
  startedAt    DateTime              @map("started_at")
  endedAt      DateTime?             @map("ended_at")
  endReason    WorkSessionEndReason? @map("end_reason")
  /// 4.1 shared computer: when the person said they are taking the next shift. An
  /// extended day is not auto-closed at the shift end; it runs until End Day.
  extendedAt   DateTime?             @map("extended_at")
  /// AGENT | LEGACY | BACKFILL
  source       String                @default("AGENT")
  /// Why the day started late (3.2): set on the day's first session when Start Day came
  /// later than the shift start plus the late-start grace. From the agent or the portal.
  lateReason   String?               @map("late_reason")
  lateReasonAt DateTime?             @map("late_reason_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([endedAt])
  @@index([userId, endedAt])
  @@map("work_sessions")
}

/// A meeting a person reported (3.1): started live from the agent, or logged
/// afterwards. Counts as focus time; a rejection takes it off.
model MeetingRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  user              User                @relation("MeetingRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  date              String
  mode              MeetingMode
  agenda            String
  /// [{ "id"?: uuid, "name": string }]
  participants      Json                @default("[]")
  /// 4.0: who will mail the minutes of meeting (required from 4.0 agents).
  momSender         String?             @map("mom_sender")
  startedAt         DateTime            @map("started_at")
  endedAt           DateTime?           @map("ended_at")
  durationSec       Int?                @map("duration_sec")
  presenceSessionId String?             @unique @map("presence_session_id") @db.Uuid
  presenceSession   PresenceSession?    @relation(fields: [presenceSessionId], references: [id], onDelete: SetNull)
  approvalStatus    BreakApprovalStatus @default(PENDING) @map("approval_status")
  approverRole      RoleName?           @map("approver_role")
  approverId        String?             @map("approver_id") @db.Uuid
  decidedById       String?             @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?           @map("decided_at")
  decisionNote      String?             @map("decision_note")
  dueAt             DateTime?           @map("due_at")
  escalatedAt       DateTime?           @map("escalated_at")
  remindedAt        DateTime?           @map("reminded_at")
  /// 3.6: a status meeting is STATUS; everything earlier is DECLARED.
  kind              MeetingKind         @default(DECLARED)
  startSource       MeetingStartSource? @map("start_source")
  /// The start, then each "Still in it": the 2 hour check counts from here.
  confirmedAt       DateTime?           @map("confirmed_at")
  endReason         MeetingEndReason?   @map("end_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([approverId, approvalStatus, date])
  @@index([approverRole, approvalStatus, date])
  @@index([approvalStatus, dueAt])
  @@map("meeting_records")
}

/// Organisation settings (3.1), one JSON value per key. Key `org` holds the
/// Super Admin settings table (SPEC 1.10).
/// A manual change to one person's focus time for one day (3.3): the Super
/// Manager adds or takes off minutes, with a reason, while a rollout is bedding in.
/// Append-only: a mistake is voided, never edited, so the trail stays complete.
model FocusAdjustment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// Business day the adjustment belongs to (YYYY-MM-DD).
  date        String
  /// Signed seconds added to (or taken off) the day's focus time.
  deltaSec    Int       @map("delta_sec")
  reason      String
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id") @db.Uuid

  @@index([userId, date])
  @@index([date])
  @@index([createdAt])
  @@map("focus_adjustments")
}

/// Per-person agent diagnostics (3.3): when any agent call last arrived, which
/// agent it was (its User-Agent), and the last screenshot upload the server
/// refused. One row per person, rewritten in place; read by GET /agent-health.
model AgentContact {
  userId            String    @id @map("user_id") @db.Uuid
  lastContactAt     DateTime  @map("last_contact_at")
  userAgent         String?   @map("user_agent")
  lastRefusalAt     DateTime? @map("last_refusal_at")
  lastRefusalStatus Int?      @map("last_refusal_status")
  lastRefusalCode   String?   @map("last_refusal_code")
  lastRefusalReason String?   @map("last_refusal_reason")
  lastRefusalBytes  Int?      @map("last_refusal_bytes")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("agent_contacts")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// A monthly report built at 00:30 on the 1st for one owner (3.1).
model ReportRun {
  id          String   @id @default(uuid()) @db.Uuid
  /// 4.0: the organisation the run covers.
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month       String
  /// TEAM | ALL
  scope       String
  ownerId     String   @map("owner_id") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at")
  summary     Json

  @@unique([companyId, month, scope, ownerId])
  @@index([ownerId, month])
  @@map("report_runs")
}

/// A month closed for payroll (3.1): reports read the snapshot, decisions are refused.
/// 4.0: payroll month locks are per organisation.
model MonthLock {
  companyId  String   @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month      String
  lockedById String   @map("locked_by_id") @db.Uuid
  lockedAt   DateTime @default(now()) @map("locked_at")
  snapshot   Json

  @@id([companyId, month])
  @@map("month_locks")
}

/// Dated shift assignment. A person's shift on a given day is the newest USER row
/// in force that day, else their department's newest DEPARTMENT row, else the
/// default shift. Rows are never edited, only superseded, so history is kept.
model ShiftAssignment {
  id            String                @id @default(uuid()) @db.Uuid
  target        ShiftAssignmentTarget
  companyId     String?               @map("company_id") @db.Uuid
  /// Department as typed (for display) and its normalised key (for matching).
  department    String?
  departmentKey String?               @map("department_key")
  userId        String?               @map("user_id") @db.Uuid
  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null on a USER row means "back to the department's shift".
  shiftId       String?               @map("shift_id") @db.Uuid
  shift         Shift?                @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  /// Local day (YYYY-MM-DD) the assignment starts.
  effectiveFrom String                @map("effective_from")
  /// Optional last local day (inclusive). Only used on USER rows.
  effectiveTo   String?               @map("effective_to")
  createdById   String?               @map("created_by_id") @db.Uuid
  /// 4.1: a one-day USER row written at Start Day, picking one of the department's
  /// shifts by the time (not an Admin's choice; never shown as a person's own shift).
  autoPicked    Boolean               @default(false) @map("auto_picked")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([target, departmentKey, effectiveFrom])
  @@index([userId, effectiveFrom])
  @@index([shiftId])
  @@map("shift_assignments")
}

/// 4.1: a department's extra shifts. Beside its main shift (the DEPARTMENT row in
/// shift_assignments), people of the department get whichever of these is on when
/// they press Start Day (in a gap, the next one).
model DepartmentShift {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  departmentKey String   @map("department_key")
  shiftId       String   @map("shift_id") @db.Uuid
  shift         Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([companyId, departmentKey, shiftId])
  @@index([departmentKey])
  @@map("department_shifts")
}

/// A break that was actually taken, with a copy of the schedule it was judged
/// against (so later shift edits never rewrite history) and its approval trail.
/// End time and overrun come from the linked presence session.
model BreakRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  user              User                @relation("BreakRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Local day (YYYY-MM-DD) the break belongs to.
  date              String
  /// Null for an unscheduled break.
  kind              BreakKind?
  seq               Int                 @default(0)
  presenceType      PresenceType        @map("presence_type")
  shiftId           String?             @map("shift_id") @db.Uuid
  shift             Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftName         String?             @map("shift_name")
  scheduledStart    DateTime?           @map("scheduled_start")
  durationMin       Int?                @map("duration_min")
  windowOpen        DateTime?           @map("window_open")
  windowClose       DateTime?           @map("window_close")
  ringStart         DateTime?           @map("ring_start")
  ringEnd           DateTime?           @map("ring_end")
  presenceSessionId String?             @unique @map("presence_session_id") @db.Uuid
  presenceSession   PresenceSession?    @relation(fields: [presenceSessionId], references: [id], onDelete: SetNull)
  startedAt         DateTime            @map("started_at")
  timing            BreakTiming
  /// Minutes early or late against the scheduled start (always >= 0).
  minutesOff        Int                 @default(0) @map("minutes_off")
  reason            String?
  overrunReason     String?             @map("overrun_reason")
  /// AGENT (the break flow) or LEGACY (an older agent's plain break/lunch).
  source            String              @default("AGENT")
  approvalStatus    BreakApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  /// SUPER_ADMIN when routed to the Super Admin pool; else the approver's role.
  approverRole      RoleName?           @map("approver_role")
  approverId        String?             @map("approver_id") @db.Uuid
  decidedById       String?             @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?           @map("decided_at")
  decisionNote      String?             @map("decision_note")
  /// 3.1: TAKEN, or a skip (no presence session; startedAt = when it was skipped).
  outcome           BreakOutcome        @default(TAKEN)
  /// Seconds past the break's length, stored when the break ends through /breaks/end.
  overrunSec        Int?                @map("overrun_sec")
  /// The person asked their manager to count the overrun as focus time.
  overrunAsked      Boolean             @default(false) @map("overrun_asked")
  /// When the comment on an auto-skip was added (stored in `reason`).
  commentedAt       DateTime?           @map("commented_at")
  /// 48-hour rule: set every time the record becomes PENDING.
  dueAt             DateTime?           @map("due_at")
  escalatedAt       DateTime?           @map("escalated_at")
  remindedAt        DateTime?           @map("reminded_at")
  /// 4.0: ACTIVE / PAUSED / ENDED. Pre-4.0 rows are ENDED or have an open presence session.
  state             BreakState          @default(ENDED)
  /// 4.0 quick breaks: the planned length in minutes (5, 10 or 15 from the agent).
  plannedMin        Int?                @map("planned_min")
  /// 4.0: when the break was finally ended (segments may have stopped earlier).
  endedAt           DateTime?           @map("ended_at")
  /// 4.0: seconds taken over all segments, stored when the break ends.
  takenSec          Int?                @map("taken_sec")
  segments          BreakSegment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date, kind, seq])
  @@index([userId, date])
  @@index([approverId, approvalStatus, date])
  @@index([approverRole, approvalStatus, date])
  @@index([approvalStatus, date])
  @@index([approvalStatus, dueAt])
  @@map("break_records")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  // bcrypt hash (never the plaintext).
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  designation  String?
  department   String?
  status       UserStatus @default(ACTIVE)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  managerId String? @map("manager_id") @db.Uuid
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  shiftId    String? @map("shift_id") @db.Uuid
  shift      Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftStart String? @map("shift_start")
  shiftEnd   String? @map("shift_end")

  // First time this user's agent enrolled (installed & activated). Set once, then
  // used to notify their manager exactly once. Null = agent never activated yet.
  agentActivatedAt DateTime? @map("agent_activated_at")

  /// Raised by one whenever the person's credentials must end (sign out everywhere,
  /// a block or unblock, a delete, a role or manager change). Access tokens, socket
  /// tickets and enrolment tokens carry the value they were minted under (`ep`) and
  /// are refused once it has moved. A token without the claim counts as 0.
  authEpoch Int @default(0) @map("auth_epoch")

  /// Whether this user's agent takes automatic screenshots. Turning it off stops
  /// only that periodic capture — activity tracking carries on, and a manager can
  /// still request a shot by hand. Defaults on, so existing users are unaffected.
  screenshotsEnabled Boolean @default(true) @map("screenshots_enabled")

  /// How the person's day is recorded (3.5): AGENT (the desktop app) or BIOMETRIC
  /// (the first and last punch of the day). Never both.
  attendanceSource     String  @default("AGENT") @map("attendance_source")
  /// The code the biometric device knows the person by, normalised; 4.0: one
  /// person per code in an organisation.
  biometricCode        String? @map("biometric_code")
  /// The day (YYYY-MM-DD) the source last changed: punches shape days from then on.
  attendanceSourceFrom String? @map("attendance_source_from")

  biometricSourcePeriods BiometricSourcePeriod[]
  /// Picks the avatar library and the default avatar (3.6). Null: not set yet, the
  /// person shows initials. Set by a Super Admin.
  gender                 Gender?
  /// The preset the person chose: a manifest ID, nothing else is ever stored. Null
  /// means the default for their gender.
  avatarId               String?                 @map("avatar_id")

  /// 4.0: the person's department (staff: required; managers: their own, optional).
  departmentId       String?             @map("department_id") @db.Uuid
  departmentRef      Department?         @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  /// 4.0 manager view grants, set by the organisation Admin.
  grantScreenshots   Boolean             @default(false) @map("grant_screenshots")
  grantTimeline      Boolean             @default(false) @map("grant_timeline")
  grantActivity      Boolean             @default(false) @map("grant_activity")
  /// 4.0 away tracking override: null = follow the department.
  idleEnabled        Boolean?            @map("idle_enabled")
  idleMinutes        Int?                @map("idle_minutes")
  /// 4.0: bumped by a key sign-out or a credential reset; installer tokens carry it.
  enrollVersion      Int                 @default(1) @map("enroll_version")
  managedDepartments ManagerDepartment[]
  awayEvents         AwayEvent[]

  refreshTokens    RefreshToken[]
  devices          Device[]
  dailyReports     DailyReport[]
  auditLogs        AuditLog[]
  presenceSessions PresenceSession[]
  onlineSessions   OnlineSession[]
  activitySamples  ActivitySample[]
  workDayEnds      WorkDayEnd[]
  shiftAssignments ShiftAssignment[]
  breakRecords     BreakRecord[]     @relation("BreakRecordUser")
  workSessions     WorkSession[]
  meetingRecords   MeetingRecord[]   @relation("MeetingRecordUser")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([companyId, biometricCode])
  @@index([roleId])
  @@index([managerId])
  @@index([department])
  @@index([status])
  @@index([companyId])
  @@index([departmentId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the issued refresh token (we never store the raw token).
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  // Link to the token that replaced this one (rotation chain).
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Device {
  id           String  @id @default(uuid()) @db.Uuid
  deviceToken  String? @map("device_token")
  hostname     String
  username     String
  displayName  String  @map("display_name")
  agentVersion String? @map("agent_version")

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  pairedAt DateTime @default(now()) @map("paired_at")
  lastSeen DateTime @default(now()) @map("last_seen")

  lastStats Json? @map("last_stats")

  reports     DailyReport[]
  screenshots Screenshot[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([lastSeen])
  @@map("devices")
}

model DailyReport {
  id       String  @id @default(uuid()) @db.Uuid
  date     String
  deviceId String? @map("device_id") @db.Uuid
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name     String
  hostname String?

  totalSec        Int @default(0) @map("total_sec")
  activeSec       Int @default(0) @map("active_sec")
  idleSec         Int @default(0) @map("idle_sec")
  productiveSec   Int @default(0) @map("productive_sec")
  extraSec        Int @default(0) @map("extra_sec")
  workingBasisSec Int @default(28800) @map("working_basis_sec")

  topApps     Json? @map("top_apps")
  topWebsites Json? @map("top_websites")
  hourly      Json?
  idleBlocks  Json? @map("idle_blocks")

  clockInMs  BigInt? @map("clock_in_ms")
  outMs      BigInt? @map("out_ms")
  clockedOut Boolean @default(false) @map("clocked_out")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, userId, deviceId])
  @@index([date])
  @@index([userId])
  @@map("daily_reports")
}

// Records that a user explicitly ended their working day (the "End Day" button).
// One row per user per local day. While no row exists for today, the agent keeps
// capturing screenshots (including overtime past the 9h basis and idle stretches);
// once the day is ended, capture stops for the rest of that local day.
model WorkDayEnd {
  id      String    @id @default(uuid()) @db.Uuid
  userId  String    @map("user_id") @db.Uuid
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Local calendar day (YYYY-MM-DD), server timezone — matches activity/presence.
  date    String
  // When the user logged into their PC (first logon of the day). Set on the first
  // activity report; earliest wins. Null until the agent reports a login.
  loginAt DateTime? @map("login_at")
  // When the user pressed "End Day". Null while the day is still open — a row can
  // exist for the login alone, so "day ended" means endedAt IS NOT NULL, not "row exists".
  endedAt DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("work_day_ends")
}

// A single stretch of time an employee spent on a break / lunch / meeting.
// Opening a session records `startedAt`; closing it fills `endedAt` + `durationSec`.
// An open session (endedAt = null) is the user's *current* status ("live").
// `date` is the local calendar day (YYYY-MM-DD) the session started, for day-wise rollups.
model PresenceSession {
  id       String       @id @default(uuid()) @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?      @map("device_id") @db.Uuid
  type     PresenceType
  // Optional note the employee sends the manager (used for MEETING sessions).
  note     String?
  date     String

  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationSec Int?      @map("duration_sec")

  breakRecord   BreakRecord?
  meetingRecord MeetingRecord?
  breakSegment  BreakSegment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([userId, endedAt])
  @@map("presence_sessions")
}

/// A stretch of "online" (working) time, driven by agent heartbeats. Each active
/// heartbeat extends `lastSeenAt`; a gap longer than the grace window (or an idle
/// signal) closes the session, so online time never counts idle or offline gaps.
model OnlineSession {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String? @map("device_id") @db.Uuid
  date     String

  startedAt   DateTime  @default(now()) @map("started_at")
  lastSeenAt  DateTime  @map("last_seen_at")
  endedAt     DateTime? @map("ended_at")
  durationSec Int?      @map("duration_sec")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, date])
  @@index([userId, endedAt])
  @@map("online_sessions")
}

/// One foreground-activity sample from the agent (≈ one per minute). Each sample
/// records the app/window/website that was in the foreground and whether the
/// machine was idle. `durationSec` is the time this sample's app stayed in the
/// foreground — it is filled in when the *next* sample arrives (the newest,
/// still-open sample carries 0 and is counted live up to "now" on read).
/// Rollups (top apps, top websites, active/idle seconds, hourly split, clock
/// in/out) are computed from these rows per local day.
model ActivitySample {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String? @map("device_id") @db.Uuid
  // Local calendar day (YYYY-MM-DD) the sample was taken, for day-wise rollups.
  date     String

  at          DateTime
  durationSec Int      @default(0) @map("duration_sec")
  idle        Boolean  @default(false)
  // Workstation was locked (Win+L / logged off / RDP disconnected). Always implies
  // `idle`, but flags inactivity that began at this instant rather than one idle
  // threshold earlier — so the rollup must not reclassify the work before it.
  locked      Boolean  @default(false)

  // Friendly application name, e.g. "Google Chrome" / "Visual Studio Code".
  app   String?
  // Foreground window title (best-effort).
  title String?
  // Website host when the foreground app is a browser, e.g. "github.com".
  // Host only (never the full path/query) to keep monitoring proportionate.
  url   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@index([userId, at])
  @@map("activity_samples")
}

// How a screenshot was triggered: the agent's 5-minute timer (AUTO) or a
// manager's on-demand "capture now" request (MANUAL).
enum ScreenshotKind {
  AUTO
  MANUAL
}

model Screenshot {
  id         String         @id @default(uuid()) @db.Uuid
  deviceId   String?        @map("device_id") @db.Uuid
  device     Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userId     String?        @map("user_id") @db.Uuid
  storageKey String         @map("storage_key")
  kind       ScreenshotKind @default(AUTO)
  takenAt    DateTime       @map("taken_at")
  // OCR text extracted on upload (AWS Textract), for full-text search.
  ocrText    String?        @map("ocr_text")
  // Set when a manager archives the shot; archived shots are hidden by default.
  archivedAt DateTime?      @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([deviceId])
  @@index([userId])
  @@index([takenAt])
  @@index([userId, takenAt])
  @@map("screenshots")
}

model ChatMessage {
  id         String    @id @default(uuid()) @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  body       String
  readAt     DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fromUserId])
  @@index([toUserId])
  @@map("chat_messages")
}

// How a screenshot was triggered: the 5-minute timer (AUTO) or a manager's
// on-demand "capture now" request (MANUAL).
enum PermissionRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model PermissionRequest {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  kind      String
  reason    String?
  status    PermissionRequestStatus @default(PENDING)
  decidedBy String?                 @map("decided_by") @db.Uuid
  decidedAt DateTime?               @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("permission_requests")
}

// ----------------------------------------------------------------------------
// Notifications
// ----------------------------------------------------------------------------
model Notification {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @map("user_id") @db.Uuid
  type   String
  title  String
  body   String?
  readAt DateTime? @map("read_at")

  /// Who caused it, when that is a person — the sender of a CHAT_MESSAGE, for
  /// instance. Lets a client open that person's conversation from the toast.
  /// Null for notifications that come from the system rather than a user.
  fromUserId String? @map("from_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  actorId  String? @map("actor_id") @db.Uuid
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String? @map("entity_id")
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 4.0: organisations, departments, away tracking, calendar, sign-out keys, offline
// ---------------------------------------------------------------------------

/// A department of an organisation. Staff belong to one; managers to one or more.
model Department {
  id             String              @id @default(uuid()) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  /// Key from the themed icon set (docs/4.0/SPEC.md 7.6).
  icon           String              @default("briefcase")
  /// 4.1: one computer shared between shifts. People here are asked near their shift
  /// end whether they are taking the next shift; if not, their day ends and the agent
  /// signs out at the shift end, for the next person to sign in.
  sharedComputer Boolean             @default(false) @map("shared_computer")
  users          User[]              @relation("UserDepartment")
  managers       ManagerDepartment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([companyId])
  @@map("departments")
}

model ManagerDepartment {
  managerId    String     @map("manager_id") @db.Uuid
  manager      User       @relation(fields: [managerId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([managerId, departmentId])
  @@index([departmentId])
  @@map("manager_departments")
}

/// One stretch of a break (4.0 pause and resume). Each has its own presence session.
model BreakSegment {
  id                String           @id @default(uuid()) @db.Uuid
  breakRecordId     String           @map("break_record_id") @db.Uuid
  breakRecord       BreakRecord      @relation(fields: [breakRecordId], references: [id], onDelete: Cascade)
  presenceSessionId String?          @unique @map("presence_session_id") @db.Uuid
  presenceSession   PresenceSession? @relation(fields: [presenceSessionId], references: [id], onDelete: SetNull)
  startedAt         DateTime         @map("started_at")
  endedAt           DateTime?        @map("ended_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([breakRecordId])
  @@map("break_segments")
}

/// A stretch with no input, explained (or not) through the agent's away pop-up.
model AwayEvent {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String?    @map("company_id") @db.Uuid
  /// Shift-day (YYYY-MM-DD) the stretch belongs to.
  date         String
  startedAt    DateTime   @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  seconds      Int?
  reasonKey    String?    @map("reason_key")
  /// THINKING | MEETING | HARDWARE | OTHER | CUSTOM
  reasonKind   String?    @map("reason_kind")
  reasonLabel  String?    @map("reason_label")
  comment      String?
  /// [{ "id"?: uuid, "name": string }]
  participants Json       @default("[]")
  momSender    String?    @map("mom_sender")
  status       AwayStatus
  approverRole RoleName?  @map("approver_role")
  decidedById  String?    @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?  @map("decided_at")
  decisionNote String?    @map("decision_note")
  dueAt        DateTime?  @map("due_at")
  escalatedAt  DateTime?  @map("escalated_at")
  remindedAt   DateTime?  @map("reminded_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([companyId, status, date])
  @@index([status, dueAt])
  @@map("away_events")
}

/// A date whose working status differs from the organisation's week pattern (holidays,
/// extra working days).
model CalendarDay {
  companyId     String   @map("company_id") @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date          String
  isWorking     Boolean  @map("is_working")
  label         String?
  /// 3.5: the departments it is for (a holiday for some departments); empty: everyone.
  departmentIds String[] @default([]) @map("department_ids") @db.Uuid
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@id([companyId, date])
  @@map("calendar_days")
}

/// 3.5, on 4.0's calendar: a department's or a person's own week (working weekdays and a
/// Saturday rule). A person's own week comes first, then their department's, then the
/// organisation's week pattern; a day set on the organisation calendar beats them all.
model WorkCalendar {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  /// DEPARTMENT or PERSON
  scope          String
  departmentId   String?  @unique @map("department_id") @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  workDays       Int[]    @default([1, 2, 3, 4, 5, 6]) @map("work_days")
  /// EVERY, NONE, OFF_2_4, OFF_1_3, OFF_1_3_5 or ALTERNATE
  saturdays      String   @default("EVERY")
  saturdayAnchor String?  @map("saturday_anchor")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("work_calendars")
}

/// A 24-hour key an Admin issues so agents in its scope can sign out.
model SignOutKey {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phraseHash    String       @map("phrase_hash")
  salt          String
  scope         SignOutScope
  userIds       String[]     @default([]) @map("user_ids")
  departmentIds String[]     @default([]) @map("department_ids")
  createdById   String       @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  expiresAt     DateTime     @map("expires_at")
  revokedAt     DateTime?    @map("revoked_at")
  uses          Int          @default(0)

  @@index([companyId, expiresAt])
  @@map("sign_out_keys")
}

/// Offline replay idempotency: one row per agent event the server has applied.
model AgentEvent {
  userId        String   @map("user_id") @db.Uuid
  clientEventId String   @map("client_event_id") @db.Uuid
  kind          String
  eventAt       DateTime @map("event_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  status        Int
  body          Json

  @@id([userId, clientEventId])
  @@index([receivedAt])
  @@index([userId, eventAt])
  @@map("agent_events")
}

// What a screenshot export job makes (3.2).
//   PERSON_REPORT  one person's screenshots for a day, days, a month or a time window: one PDF
//   MONTH_ARCHIVE  every screenshot of a month: a zip of Month/Department/Employee/<day>.pdf
//   MONTH_PURGE    deletes a month's screenshots that a complete post-month archive holds
enum ScreenshotExportKind {
  PERSON_REPORT
  MONTH_ARCHIVE
  MONTH_PURGE
}

enum ScreenshotExportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// A screenshot report, monthly archive or monthly deletion, run in the background
/// while the portal shows its progress (3.2). Closing the progress window cancels it.
model ScreenshotExport {
  id              String                 @id @default(uuid()) @db.Uuid
  kind            ScreenshotExportKind
  status          ScreenshotExportStatus @default(QUEUED)
  requestedById   String                 @map("requested_by_id") @db.Uuid
  /// 4.0: the organisation the job belongs to; archives and deletions cover only its people.
  companyId       String?                @map("company_id") @db.Uuid
  /// PERSON_REPORT: whose screenshots.
  userId          String?                @map("user_id") @db.Uuid
  /// MONTH_ARCHIVE and MONTH_PURGE: "YYYY-MM".
  month           String?
  /// PERSON_REPORT: the days (inclusive) and an optional time of day window "HH:MM".
  fromDate        String?                @map("from_date")
  toDate          String?                @map("to_date")
  fromTime        String?                @map("from_time")
  toTime          String?                @map("to_time")
  /// MONTH_PURGE: the archive whose contents it deletes.
  archiveId       String?                @map("archive_id") @db.Uuid
  total           Int                    @default(0)
  done            Int                    @default(0)
  /// Screenshots whose image could not be read (shown as missing in the PDF).
  missing         Int                    @default(0)
  bytes           BigInt                 @default(0)
  storageKey      String?                @map("storage_key")
  fileName        String?                @map("file_name")
  error           String?
  /// MONTH_ARCHIVE: finished with every screenshot of the month uploaded before it started.
  complete        Boolean                @default(false)
  /// MONTH_ARCHIVE: screenshots uploaded before this instant are inside it.
  coveredUntil    DateTime?              @map("covered_until")
  cancelRequested Boolean                @default(false) @map("cancel_requested")
  /// The portal's last progress poll; a job nobody watches any more is cancelled.
  lastSeenAt      DateTime               @default(now()) @map("last_seen_at")
  startedAt       DateTime?              @map("started_at")
  finishedAt      DateTime?              @map("finished_at")
  downloadedAt    DateTime?              @map("downloaded_at")
  /// The file is removed from storage after this (the record stays).
  expiresAt       DateTime?              @map("expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([companyId, kind, month, status])
  @@index([kind, month, status])
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@map("screenshot_exports")
}

// ----------------------------------------------------------------------------
// Leave (3.4): CL/SL lapses every year, EL/PL carries over. Amounts are counted
// in quarter days ("units": a full day is 4).
// ----------------------------------------------------------------------------
enum LeaveCategory {
  CLSL
  ELPL
  /// 3.5: comp off, taken against credits earned by working extra days.
  COMPOFF
}

enum LeaveKind {
  FULL_DAY
  HALF_DAY
  QUARTER_DAY
}

enum LeavePart {
  FIRST_HALF
  SECOND_HALF
  Q1
  Q2
  Q3
  Q4
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

/// One person's pool for one year: what was granted and (EL/PL) the carry-over cap
/// in force when it opened. Balances are worked out from requests and adjustments.
model LeaveAccount {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  year          Int
  category      LeaveCategory
  grantedUnits  Int           @map("granted_units")
  /// DEFAULT (the policy's yearly days) or PERSON (their own quota).
  grantSource   String        @default("DEFAULT") @map("grant_source")
  /// Granted pro rata (joined during the year).
  prorated      Boolean       @default(false)
  carryCapUnits Int?          @map("carry_cap_units")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([userId, year, category])
  @@index([year])
  @@map("leave_accounts")
}

/// A person's own yearly days of a pool, instead of the policy's.
model LeaveQuota {
  userId       String        @map("user_id") @db.Uuid
  category     LeaveCategory
  unitsPerYear Int           @map("units_per_year")
  updatedById  String?       @map("updated_by_id") @db.Uuid
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@id([userId, category])
  @@map("leave_quotas")
}

/// A manual change to a balance (add, take off, or set), with the reason the
/// person reads. Append-only: a mistake is corrected by another adjustment.
model LeaveAdjustment {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  year        Int
  category    LeaveCategory
  deltaUnits  Int           @map("delta_units")
  /// ADD | SUBTRACT | SET
  mode        String
  /// SET: the balance asked for.
  targetUnits Int?          @map("target_units")
  reason      String
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([userId, year])
  @@index([createdAt])
  @@map("leave_adjustments")
}

/// A request for leave: one day, a part of one, or a range of full days in one
/// year. Pending requests reserve their days; approved ones take them.
model LeaveRequest {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  category     LeaveCategory
  kind         LeaveKind
  part         LeavePart?
  startDate    String            @map("start_date")
  endDate      String            @map("end_date")
  year         Int
  /// Quarter days charged (working days only).
  units        Int
  reason       String
  status       LeaveStatus       @default(PENDING)
  /// Who decides: MANAGER, SUPER_MANAGER or SUPER_ADMIN; null when approved at once.
  approverRole RoleName?         @map("approver_role")
  /// MANAGER route: the manager when it was made.
  approverId   String?           @map("approver_id") @db.Uuid
  decidedById  String?           @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?         @map("decided_at")
  decisionNote String?           @map("decision_note")
  cancelledAt  DateTime?         @map("cancelled_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  days         LeaveRequestDay[]

  @@index([userId, status])
  @@index([status, approverRole])
  @@index([startDate])
  @@index([year, category])
  @@map("leave_requests")
}

/// One charged day of a request: which quarters it covers (bits Q1 = 1 to Q4 = 8).
model LeaveRequestDay {
  id        String       @id @default(uuid()) @db.Uuid
  requestId String       @map("request_id") @db.Uuid
  request   LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id") @db.Uuid
  date      String
  mask      Int
  units     Int

  @@index([userId, date])
  @@index([date])
  @@index([requestId])
  @@map("leave_request_days")
}

// ----------------------------------------------------------------------------
// Biometric attendance (3.5): punches from the device, matched to people by their
// biometric code; a biometric person's day runs from the first punch to the last.
// ----------------------------------------------------------------------------

/// One punch. Never deleted: a wrong one is voided with a reason.
model BiometricPunch {
  id          String    @id @default(uuid()) @db.Uuid
  /// 4.0: the organisation whose key or admin sent it; codes match its people only.
  companyId   String    @map("company_id") @db.Uuid
  /// The code as the device sent it.
  code        String
  /// The code normalised for matching (users.biometric_code).
  codeKey     String    @map("code_key")
  punchedAt   DateTime  @map("punched_at")
  /// IN, OUT, or null when the device does not say.
  direction   String?
  /// The device or terminal ('' when not given); part of the duplicate check.
  deviceId    String    @default("") @map("device_id")
  /// The biometric system's own id for the punch, when it has one.
  externalId  String?   @map("external_id")
  /// PUSH | PULL | CSV | MANUAL
  source      String
  /// The person the code belongs to; null while nobody has it.
  userId      String?   @map("user_id") @db.Uuid
  /// The person's working day it belongs to (YYYY-MM-DD); the calendar day while unmatched.
  dayKey      String    @map("day_key")
  /// MANUAL: why it was added. The key or the person that sent it, for the log.
  note        String?
  createdById String?   @map("created_by_id") @db.Uuid
  keyId       String?   @map("key_id") @db.Uuid
  /// Arrived for a day in a month locked for payroll: kept, never applied.
  lockedOut   Boolean   @default(false) @map("locked_out")
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id") @db.Uuid
  voidReason  String?   @map("void_reason")
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@unique([companyId, codeKey, punchedAt, deviceId])
  @@index([companyId, codeKey, punchedAt])
  @@index([userId, dayKey])
  @@index([codeKey, punchedAt])
  @@index([punchedAt])
  @@index([receivedAt])
  @@index([deviceId, punchedAt])
  @@map("biometric_punches")
}

/// An integration key for POST /biometric/punches. The key is shown once; only its
/// SHA-256 is kept.
model BiometricKey {
  id          String    @id @default(uuid()) @db.Uuid
  /// 4.0: the organisation the key sends punches for.
  companyId   String    @map("company_id") @db.Uuid
  name        String
  /// The first characters, so a key can be recognised in the list.
  prefix      String
  hash        String    @unique
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  lastUsedIp  String?   @map("last_used_ip")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid

  @@index([companyId])
  @@map("biometric_keys")
}

// ----------------------------------------------------------------------------
// Work from home (3.5): requests approved by the reporting manager, and schedules.
// Counted in quarter days like leave (a full day is 4).
// ----------------------------------------------------------------------------

model WfhRequest {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  kind         LeaveKind
  part         LeavePart?
  startDate    String          @map("start_date")
  endDate      String          @map("end_date")
  /// Quarter days asked for (working days only).
  units        Int
  reason       String
  status       LeaveStatus     @default(PENDING)
  /// Who decides: MANAGER, SUPER_MANAGER or SUPER_ADMIN; null when approved at once.
  approverRole RoleName?       @map("approver_role")
  approverId   String?         @map("approver_id") @db.Uuid
  decidedById  String?         @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?       @map("decided_at")
  decisionNote String?         @map("decision_note")
  cancelledAt  DateTime?       @map("cancelled_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  days         WfhRequestDay[]

  @@index([userId, status])
  @@index([status, approverRole])
  @@index([startDate])
  @@map("wfh_requests")
}

/// One day of a request: which quarters it covers (bits Q1 = 1 to Q4 = 8).
model WfhRequestDay {
  id        String     @id @default(uuid()) @db.Uuid
  requestId String     @map("request_id") @db.Uuid
  request   WfhRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  date      String
  mask      Int
  units     Int

  @@index([userId, date])
  @@index([date])
  @@index([requestId])
  @@map("wfh_request_days")
}

/// Periodic work from home: these weekdays (some weeks of the month only, if set),
/// from a date, until a date or for good. Scheduled days count as approved. A
/// schedule that has begun is never edited: it is ended and a new one starts.
model WfhSchedule {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  /// ISO weekdays (1 = Monday ... 7 = Sunday).
  weekdays    Int[]
  /// Weeks of the month (1 to 5); empty: every week.
  weeks       Int[]      @default([])
  kind        LeaveKind
  part        LeavePart?
  fromDate    String     @map("from_date")
  toDate      String?    @map("to_date")
  /// Days of the pattern left out (YYYY-MM-DD).
  skipDates   String[]   @default([]) @map("skip_dates")
  note        String     @default("")
  createdById String     @map("created_by_id") @db.Uuid
  updatedById String?    @map("updated_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([fromDate])
  @@map("wfh_schedules")
}

// ----------------------------------------------------------------------------
// Comp off (3.5): a credit for an extra day worked, claimed and approved, used as
// leave of type COMPOFF before it lapses. Quarter days like leave.
// ----------------------------------------------------------------------------

model CompOffCredit {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  /// The extra day worked (YYYY-MM-DD).
  workedDate     String      @map("worked_date")
  /// WEEKLY_OFF | HOLIDAY | LEAVE | WORKING (credited by hand for a working day)
  dayKind        String      @map("day_kind")
  /// What the day was called ("Sunday", "Diwali", "On leave (CL/SL)").
  dayLabel       String      @default("") @map("day_label")
  /// Focus time that day when it was claimed, for the approver (seconds).
  workedSec      Int         @default(0) @map("worked_sec")
  /// Quarter days asked for, and given once approved.
  askedUnits     Int         @map("asked_units")
  units          Int         @default(0)
  reason         String
  /// CLAIM (the person asked) or GRANT (credited by hand).
  source         String      @default("CLAIM")
  status         LeaveStatus @default(PENDING)
  approverRole   RoleName?   @map("approver_role")
  approverId     String?     @map("approver_id") @db.Uuid
  decidedById    String?     @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?   @map("decided_at")
  decisionNote   String?     @map("decision_note")
  /// The last day the credit can be taken (set when approved).
  expiresOn      String?     @map("expires_on")
  /// When the person was told it lapses soon.
  expiryNoticeAt DateTime?   @map("expiry_notice_at")
  createdById    String      @map("created_by_id") @db.Uuid
  cancelledAt    DateTime?   @map("cancelled_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, approverRole])
  @@index([workedDate])
  @@index([expiresOn])
  @@map("comp_off_credits")
}

// ----------------------------------------------------------------------------
// RX Vision 3.6
// ----------------------------------------------------------------------------

// Which avatar library a person sees and which default they get (3.6). Set by a
// Super Admin; null on the user means not set yet.
enum Gender {
  MALE
  FEMALE
}

/// DECLARED: the 3.1 meeting (agenda, participants, approval). STATUS: "In a meeting" (3.6):
/// only its start and end travel, no approval, and the 2 hour check is its control.
enum MeetingKind {
  DECLARED
  STATUS
}

/// Where a status meeting started: the Start meeting button, or a suggestion the person tapped.
enum MeetingStartSource {
  BUTTON
  SUGGESTION
}

/// Why a status meeting ended.
enum MeetingEndReason {
  USER
  BREAK
  END_DAY
  NO_ANSWER
  AUTO_CLOSED
}

/// When an organisation's biometric integration was on (3.6; 4.0: per organisation): a
/// biometric person's payroll for a day is calculated only if a period of their
/// organisation covers that day. A history: rows are closed, never deleted. At most one
/// is open per organisation: enforced by the partial unique index
/// biometric_integration_periods_one_open (migration SQL only; Prisma cannot express it).
model BiometricIntegrationPeriod {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// First business day it was on (the day it was switched on counts in full).
  fromDate    String    @map("from_date")
  /// Last business day it was on; null while it is on.
  toDate      String?   @map("to_date")
  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  startedById String?   @map("started_by_id") @db.Uuid
  endedById   String?   @map("ended_by_id") @db.Uuid

  @@index([companyId, fromDate])
  @@map("biometric_integration_periods")
}

/// A stretch someone was on biometric, written when they move back to the agent (3.6): the
/// payroll pause reads the source in force on a date, so moving back never recalculates the
/// days before it. Their current stretch is on the user (attendanceSource, attendanceSourceFrom).
model BiometricSourcePeriod {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// First business day on biometric; null when that was never recorded (from the beginning).
  fromDate    String?  @map("from_date")
  /// Last business day on biometric: the day before the move.
  toDate      String   @map("to_date")
  changedAt   DateTime @map("changed_at")
  changedById String?  @map("changed_by_id") @db.Uuid

  @@index([userId, toDate])
  @@map("biometric_source_periods")
}

/// A phone that can receive push notifications (3.6, server half). `token` is the FCM
/// registration token: never logged and never sent back by the API. One token belongs to
/// one person (the last to sign in on that phone).
model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  /// android | ios | web
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_devices")
}

/// Every push the API would send, whether or not it went out. Holds no device
/// token and no provider key.
model PushOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  title       String
  body        String
  /// Short strings only (what the phone opens on a tap).
  data        Json      @default("{}")
  /// NOT_SENT (flag off or no credentials), NO_DEVICE, SENT or FAILED.
  sentState   String    @default("NOT_SENT") @map("sent_state")
  /// How many devices it was tried on, and how many took it.
  devices     Int       @default(0)
  delivered   Int       @default(0)
  /// Why it failed, as a short code; never the provider's answer.
  errorCode   String?   @map("error_code")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([recipientId, createdAt])
  @@index([sentState, createdAt])
  @@map("push_outbox")
}
