<Application
    x:Class="TimeChampAgent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================
                 Clean light theme with an indigo / violet accent.
                 Near-white cards on a soft lavender-tinted backdrop.
                 ============================================================ -->
            <SolidColorBrush x:Key="Brand" Color="#4F46E5" />
            <SolidColorBrush x:Key="Accent" Color="#6366F1" />
            <SolidColorBrush x:Key="Bg" Color="#EEF0FB" />
            <SolidColorBrush x:Key="Sidebar" Color="#E4E7F7" />
            <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Chat" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Row" Color="#EEF0FB" />
            <SolidColorBrush x:Key="RowActive" Color="#E7E9FE" />
            <SolidColorBrush x:Key="Text" Color="#1E2233" />
            <SolidColorBrush x:Key="Muted" Color="#8A93A8" />
            <SolidColorBrush x:Key="Green" Color="#22C55E" />
            <SolidColorBrush x:Key="Danger" Color="#E5484D" />
            <SolidColorBrush x:Key="Divider" Color="#EAECF5" />
            <SolidColorBrush x:Key="BubbleIn" Color="#F1F3F9" />
            <SolidColorBrush x:Key="BubbleOut" Color="#4F46E5" />
            <SolidColorBrush x:Key="PauseBase" Color="#4F46E5" />
            <SolidColorBrush x:Key="ResumeBase" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InputField" Color="#F1F3F9" />
            <SolidColorBrush x:Key="InputInk" Color="#1E2233" />
            <SolidColorBrush x:Key="ChatHeader" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StateIconBg" Color="#EEF0FB" />
            <SolidColorBrush x:Key="ModalBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ModalText" Color="#1E2233" />
            <SolidColorBrush x:Key="ConfirmTeal" Color="#4F46E5" />

            <!-- Indigo → violet arc gradient for the timer / focus rings. -->
            <LinearGradientBrush x:Key="RingGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#818CF8" Offset="0" />
                <GradientStop Color="#4F46E5" Offset="1" />
            </LinearGradientBrush>

            <!-- Solid-indigo fill for the Pause button. -->
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6366F1" Offset="0" />
                <GradientStop Color="#4F46E5" Offset="1" />
            </LinearGradientBrush>

            <!-- Soft, clean light window backdrop (gentle wash). -->
            <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4F5FD" Offset="0" />
                <GradientStop Color="#E7E9F8" Offset="1" />
            </LinearGradientBrush>

            <!-- End Day button: deep indigo → violet diagonal gradient. -->
            <LinearGradientBrush x:Key="EndDayGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4F46E5" Offset="0" />
                <GradientStop Color="#4338CA" Offset="0.55" />
                <GradientStop Color="#3730A3" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EndDayGradientHover" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B52F0" Offset="0" />
                <GradientStop Color="#4B40D6" Offset="0.55" />
                <GradientStop Color="#3F37B0" Offset="1" />
            </LinearGradientBrush>

            <!-- A polished, tall gradient "End Day" button with a soft red glow and
                 press/hover feedback. -->
            <Style x:Key="EndDayButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Soft red glow behind the pill. -->
                                <Border x:Name="Glow" CornerRadius="16" Margin="6,8,6,2"
                                        Background="#4F46E5" Opacity="0.35">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                </Border>
                                <Border x:Name="Fill" CornerRadius="16"
                                        Background="{StaticResource EndDayGradient}">
                                    <ContentPresenter x:Name="Content"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EndDayGradientHover}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                                 To="0.85" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                                 To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
