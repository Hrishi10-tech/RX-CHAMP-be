<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RXVision.Agent.ViewModels"
             x:Class="RXVision.Agent.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">
  <UserControl.Styles>
    <Style Selector="Border.day">
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="1" />
    </Style>
    <Style Selector="Border.day TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.day.off"><Setter Property="Background" Value="{StaticResource Brush.Field}" /></Style>
    <Style Selector="Border.day.off TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Neutral}" /></Style>
    <Style Selector="Border.day.holiday"><Setter Property="Background" Value="{StaticResource Brush.BrandWash}" /></Style>
    <Style Selector="Border.day.holiday TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Brand}" /></Style>
    <Style Selector="Border.day.today">
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Classes="ghost" Command="{Binding PreviousYearCommand}" ToolTip.Tip="Previous year" AutomationProperties.Name="Previous year" VerticalAlignment="Center">
            <PathIcon Classes="i" Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16" />
          </Button>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
            <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{Binding Year}" />
            <TextBlock Classes="small" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding TotalsShown}" />
            <TextBlock Classes="small" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding Summary}" TextWrapping="Wrap"
                       IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost" Command="{Binding NextYearCommand}" ToolTip.Tip="Next year" AutomationProperties.Name="Next year" VerticalAlignment="Center">
            <PathIcon Classes="i" Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16" />
          </Button>
        </Grid>
      </Border>
      <Border Classes="note" IsVisible="{Binding HasProblem}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12.5" />
      </Border>
      <ItemsControl ItemsSource="{Binding Months}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CalendarMonth">
            <Border Classes="card" Padding="12" Margin="0,0,0,10" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <TextBlock Classes="title" Text="{Binding Name}" />
                <UniformGrid Columns="7">
                  <TextBlock Classes="small" Text="M" HorizontalAlignment="Center" />
                  <TextBlock Classes="small" Text="T" HorizontalAlignment="Center" />
                  <TextBlock Classes="small" Text="W" HorizontalAlignment="Center" />
                  <TextBlock Classes="small" Text="T" HorizontalAlignment="Center" />
                  <TextBlock Classes="small" Text="F" HorizontalAlignment="Center" />
                  <TextBlock Classes="small" Text="S" HorizontalAlignment="Center" />
                  <TextBlock Classes="small" Text="S" HorizontalAlignment="Center" />
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarCell">
                      <Border Classes="day" Classes.off="{Binding IsWeeklyOff}" Classes.holiday="{Binding IsHoliday}" Classes.today="{Binding IsToday}"
                              ToolTip.Tip="{Binding ToolTip}" Background="Transparent">
                        <TextBlock Text="{Binding Text}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card" IsVisible="{Binding HasHolidays}">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" Text="Holidays" />
          <ItemsControl ItemsSource="{Binding Holidays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarHolidayRow">
                <Grid ColumnDefinitions="96,*" Margin="0,0,0,4">
                  <TextBlock Classes="muted" Text="{Binding Date}" />
                  <TextBlock Grid.Column="1" FontSize="13" Text="{Binding Label}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
