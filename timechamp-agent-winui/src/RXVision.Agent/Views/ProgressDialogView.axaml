<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:RXVision.Agent.ViewModels.Dialogs"
             x:Class="RXVision.Agent.Views.ProgressDialogView"
             x:DataType="dlg:ProgressDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <!-- 4.0: sending what waits before a sign-out, drawn as the 3.6 panel's dialogs. -->
  <Grid RowDefinitions="*,Auto">
    <StackPanel Margin="20,26,20,20" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <PathIcon Classes="spinner" Width="18" Height="18" VerticalAlignment="Center" />
        <TextBlock Classes="h2" Text="{Binding Heading}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="lead" Text="{Binding Message}" />
    </StackPanel>
    <Border Grid.Row="1" Classes="dialogfooter">
      <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
    </Border>
  </Grid>
</UserControl>
