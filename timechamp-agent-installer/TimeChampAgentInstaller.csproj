<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RXChampAgent</AssemblyName>
    <RootNamespace>TimeChampAgentInstaller</RootNamespace>
    <Version>2.0.0</Version>
    <Company>RX Champ</Company>
    <Product>RX Champ Agent Installer</Product>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole self-contained WinUI agent, zipped, embedded into this exe.
         Regenerate payload/app.zip whenever the agent changes (see README note). -->
    <EmbeddedResource Include="payload\app.zip" LogicalName="app.zip" />
  </ItemGroup>

</Project>
