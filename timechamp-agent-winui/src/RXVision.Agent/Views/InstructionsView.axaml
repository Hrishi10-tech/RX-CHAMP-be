<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RXVision.Agent.ViewModels"
             x:Class="RXVision.Agent.Views.InstructionsView"
             x:DataType="vm:InstructionsViewModel">
  <!-- Instructions: how the 4.0 agent works (one column, the 3.6 panel's width), then the
       organisation's own guide from the server (GET /workday/guide), in order. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
      <StackPanel Spacing="3">
        <TextBlock Classes="h2" Text="How RX Vision works" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Focus time runs from Start day to End day, minus breaks and unexplained away time." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="1. Start and end your day" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Tap Start day when you begin work. Nothing is recorded before it." />
          <TextBlock Classes="body" Text="Tap End day when you finish. Skipped breaks need a comment first." />
          <TextBlock Classes="body" Text="Closing the panel only hides it. RX Vision keeps running beside the icon." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="2. Today's actions" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Quick break: 5, 10 or 15 minutes, any time the day runs." />
          <TextBlock Classes="body" Text="Next break: your next scheduled break. Tap it when it is open, or to resume a paused one." />
          <TextBlock Classes="body" Text="Start meeting: you're in a meeting until you tap End meeting. Meeting with details records the agenda and people, or logs an earlier one." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="3. Breaks and their windows" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Each break can start while its window is open. When it is due the icon says so: start it then and no reason is needed." />
          <TextBlock Classes="body" Text="Earlier or later asks why; your department's managers approve it. A break you don't take is skipped and needs a comment." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="4. Pause and resume" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="A scheduled break can be paused if you are needed: focus time starts again at once." />
          <TextBlock Classes="body" Text="Resume it from Next break before its window closes. If it closes first, the break ends at the pause." />
          <TextBlock Classes="body" Text="Resume work always asks first, so a stray click never ends a break." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="5. Quick breaks and paid break time" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Your scheduled breaks plus a small buffer (10 minutes unless your organisation sets another) are paid." />
          <TextBlock Classes="body" Text="Quick breaks and minutes over a break use the buffer first. Past it, break time is unpaid. Today shows the line: Paid breaks 1h 05m of 1h 30m." />
          <TextBlock Classes="body" Text="Paid time, beside that line and in History, is your focus time plus paid break time: what your pay counts." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="6. Meetings" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Start meeting when a meeting begins and End meeting when it ends. Your focus time keeps counting." />
          <TextBlock Classes="body" Text="If a call is still open on your computer, RX Vision asks before it ends the meeting, and asks again after 2 hours." />
          <TextBlock Classes="body" Text="With details, say who will mail the minutes. Your department's managers approve the meeting afterwards." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="7. When you're away" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="If your organisation turns it on, no keyboard or mouse for a few minutes asks where you were. A locked screen counts as away." />
          <TextBlock Classes="body" Text="Took a break makes it a quick break from when you left. Any other reason goes for approval: approved, it counts as focus time." />
          <TextBlock Classes="body" Text="Unanswered away time is not focus time." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="8. History" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Profile, then History: each month's working time against its target, day by day, with your meetings and away time." />
          <TextBlock Classes="body" Text="A decision made later changes the day it belongs to straight away." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="9. Working offline" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Every button works without the internet. What you do is saved on this computer at once and sent in order when you're back online." />
          <TextBlock Classes="body" Text="The sync line on Today says how many actions are waiting. If RX Vision refuses one later, you'll see a note once." />
          <TextBlock Classes="body" Text="Time recorded offline counts once its activity data arrives. Until then Today and History show it as Offline, no activity data." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" FontSize="14" Text="10. Signing out" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="Sign out is on the Profile tab. It sends everything first, so it needs the internet, then asks for a key from your admin." />
          <TextBlock Classes="body" Text="A key works for 24 hours. Only admins can quit RX Vision, with a key." />
        </StackPanel>
      </Border>

      <!-- 3.2: the organisation's own guide (GET /workday/guide), with its numbers filled in. -->
      <StackPanel Spacing="3" Margin="0,6,0,0">
        <TextBlock Classes="h2" Text="Your organisation's rules" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="The same points with your organisation's own times and limits." />
      </StackPanel>
      <Border Classes="note" IsVisible="{Binding HasNote}">
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="13" />
      </Border>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GuideRow">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="title" FontSize="14" Text="{Binding Heading}" TextWrapping="Wrap" />
                <TextBlock Classes="body" Text="{Binding Body}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
