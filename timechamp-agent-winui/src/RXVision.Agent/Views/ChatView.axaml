<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RXVision.Agent.ViewModels"
             x:Class="RXVision.Agent.Views.ChatView"
             x:DataType="vm:ChatViewModel">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Who you're talking to -->
      <Border BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="20,0,20,10">
        <Panel>
          <TextBlock Text="{Binding HeaderText}" FontSize="14" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasManyContacts}" />
          <ComboBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" AutomationProperties.Name="Chat with" IsVisible="{Binding HasManyContacts}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContactItem">
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Panel>
      </Border>

      <!-- The conversation, newest at the bottom -->
      <ScrollViewer Grid.Row="1" Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="20,14,20,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageItem">
              <Panel Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Left" IsVisible="{Binding IsTheirs}" MaxWidth="270">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Brush.NeutralFill}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initials}" FontSize="10.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="3">
                    <Border Background="{StaticResource Brush.Card}" CornerRadius="4,14,14,14" Padding="12,8" HorizontalAlignment="Left">
                      <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                    <TextBlock Classes="small" FontSize="10.5" Text="{Binding Stamp}" />
                  </StackPanel>
                </Grid>
                <StackPanel HorizontalAlignment="Right" Spacing="3" MaxWidth="270" IsVisible="{Binding IsMine}">
                  <Border Background="{StaticResource Brush.BrandWashHover}" CornerRadius="14,4,14,14" Padding="12,8" HorizontalAlignment="Right">
                    <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="13" />
                  </Border>
                  <TextBlock Classes="small" FontSize="10.5" Text="{Binding Stamp}" HorizontalAlignment="Right" />
                </StackPanel>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="24"
                  IsVisible="{Binding IsEmpty}">
        <PathIcon Classes="i" Data="{StaticResource Icon.Chat}" Width="26" Height="26" Foreground="{StaticResource Brush.Neutral}" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" FontSize="13" Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
      </StackPanel>

      <!-- Write -->
      <StackPanel Grid.Row="2" Margin="20,4,20,16" Spacing="4">
        <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="22" Padding="6,4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Name="Input"
                     Classes="chatinput"
                     Text="{Binding Draft}"
                     Watermark="Write a message"
                     MaxLength="{Binding MaxChars}"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     MaxHeight="96"
                     IsEnabled="{Binding CanType}"
                     AutomationProperties.Name="Message">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="send" Command="{Binding SendCommand}" VerticalAlignment="Bottom"
                    ToolTip.Tip="Send" AutomationProperties.Name="Send">
              <PathIcon Classes="i" Data="{StaticResource Icon.Send}" Width="16" Height="16" Foreground="{StaticResource Brush.BrandLabel}" />
            </Button>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto" Margin="12,0,12,0">
          <TextBlock Classes="error" Text="{Binding SendError}" IsVisible="{Binding SendError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Column="1" Classes="small" Text="{Binding CounterText}" IsVisible="{Binding HasCounter}" />
        </Grid>
      </StackPanel>
    </Grid>
</UserControl>
