<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Text ===================================================================== -->
  <!-- Ink is inherited from the window, so text inside buttons keeps the button's colour. -->
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Brush.RedInk}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- ===== Icons ==================================================================== -->
  <Style Selector="PathIcon.i">
    <Setter Property="Theme" Value="{StaticResource StrokeIcon}" />
  </Style>
  <Style Selector="PathIcon.spinner">
    <Setter Property="Theme" Value="{StaticResource StrokeIcon}" />
    <Setter Property="Data" Value="{StaticResource Icon.Spinner}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== Surfaces ================================================================= -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 2 10 0 #141E2233" />
  </Style>
  <Style Selector="Border.subcard">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,11" />
  </Style>
  <Style Selector="Border.iconcircle">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Banners above the dashboard -->
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Border.banner.ended">
    <Setter Property="Background" Value="{StaticResource Brush.IndigoBg}" />
    <Setter Property="BorderBrush" Value="#A5A8F0" />
  </Style>
  <Style Selector="Border.banner.warn">
    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberBorder}" />
  </Style>
  <Style Selector="Border.banner.info">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#C7CBFA" />
  </Style>

  <!-- ===== Buttons ================================================================== -->
  <Style Selector="Button">
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <Style Selector="Button.primary, Button.secondary, Button.danger, Button.soft">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandHover}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandPressed}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandDisabled}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#D92D33" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B42318" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#9B1C1C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.FieldBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F4F5FA" />
    <Setter Property="BorderBrush" Value="#B7BCCC" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#ECEEF5" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
  </Style>

  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoftHover}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandHover}" />
  </Style>
  <Style Selector="Button.soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D5D8FB" />
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandPressed}" />
  </Style>

  <!-- Text links -->
  <Style Selector="Button.link">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandHover}" />
  </Style>
  <Style Selector="Button.link PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.link:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Small icon buttons (close, dismiss) -->
  <Style Selector="Button.ghost">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14000000" />
  </Style>
  <Style Selector="Button.ghost PathIcon">
    <Setter Property="Foreground" Value="#6B7280" />
  </Style>

  <!-- The big End day button -->
  <Style Selector="Button.endday">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Background" Value="{StaticResource Brush.EndDay}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Height" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.endday:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.EndDayHover}" />
  </Style>
  <Style Selector="Button.endday:pressed">
    <Setter Property="RenderTransform" Value="scale(0.99)" />
  </Style>
  <Style Selector="Button.endday:disabled">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.endday TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Big "Back to work" on the break panel: colour follows the panel. -->
  <Style Selector="Button.back">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Background" Value="{StaticResource Brush.AmberStrong}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Height" Value="46" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.back TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.back.lunch">
    <Setter Property="Background" Value="{StaticResource Brush.TealStrong}" />
  </Style>
  <Style Selector="Button.back.over">
    <Setter Property="Background" Value="{StaticResource Brush.RedInk}" />
  </Style>
  <Style Selector="Button.back:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.back:pressed">
    <Setter Property="RenderTransform" Value="scale(0.99)" />
  </Style>
  <Style Selector="Button.back:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- 4.0: Pause beside End break (outlined, the panel's colour) -->
  <Style Selector="Button.pause">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberBorder}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Height" Value="46" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource Brush.AmberStrong}" />
  </Style>
  <Style Selector="Button.pause TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.AmberStrong}" />
  </Style>
  <Style Selector="Button.pause PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.AmberStrong}" />
  </Style>
  <Style Selector="Button.pause.lunch">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TealBorder}" />
  </Style>
  <Style Selector="Button.pause.lunch TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.TealStrong}" />
  </Style>
  <Style Selector="Button.pause.lunch PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.TealStrong}" />
  </Style>
  <Style Selector="Button.pause:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
  </Style>
  <Style Selector="Button.pause:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- 4.0: small buttons inside a break row (Resume, End) -->
  <Style Selector="Button.rowaction">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.rowaction TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.rowaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoftHover}" />
  </Style>
  <Style Selector="Button.rowaction.quiet">
    <Setter Property="Background" Value="{StaticResource Brush.NeutralBg}" />
  </Style>
  <Style Selector="Button.rowaction.quiet TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Neutral}" />
  </Style>
  <Style Selector="Button.rowaction:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- 4.0: the hamburger menu (header) -->
  <Style Selector="Button.burger">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.burger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
  </Style>
  <Style Selector="Button.burger.on">
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Border.menu">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 16 40 0 #33141828" />
  </Style>
  <Style Selector="Button.menuitem">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
  </Style>
  <Style Selector="Button.menuitem TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
  </Style>
  <Style Selector="Button.menuitem PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
  </Style>
  <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Field}" />
  </Style>
  <Style Selector="Button.menuitem.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
  </Style>
  <Style Selector="Button.menuitem.on TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.menuitem.on PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.menuitem.quit TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.RedInk}" />
  </Style>
  <Style Selector="Button.menuitem.quit PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.RedInk}" />
  </Style>

  <!-- 4.0: History and Instructions -->
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{StaticResource Brush.TileBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TileBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="Border.guide">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #12141828" />
  </Style>
  <Style Selector="Border.mock">
    <Setter Property="Background" Value="{StaticResource Brush.TileBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TileBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="TextBlock.step">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="19" />
  </Style>

  <!-- ===== Inputs =================================================================== -->
  <Style Selector="TextBox.field">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.FieldBorder}" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#AEB3C4" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark, TextBox.field /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="#7C8497" />
  </Style>

  <!-- ===== Quick-status tiles (Theme TileButton) ======================================= -->
  <Style Selector="Button.tile Border.iconbox">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tile Border.iconbox PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.tile TextBlock.tiletitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Button.tile TextBlock.tilevalue">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="Button.tile TextBlock.tilecaption">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="LineHeight" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Button.tile Border.chip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.tile Border.chip > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Accent, idle -->
  <Style Selector="Button.tile.amber Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.AmberIcon}" /></Style>
  <Style Selector="Button.tile.amber Border.iconbox PathIcon"><Setter Property="Foreground" Value="{StaticResource Brush.Amber}" /></Style>
  <Style Selector="Button.tile.teal Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.TealIcon}" /></Style>
  <Style Selector="Button.tile.teal Border.iconbox PathIcon"><Setter Property="Foreground" Value="{StaticResource Brush.Teal}" /></Style>
  <Style Selector="Button.tile.indigo Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.IndigoIcon}" /></Style>
  <Style Selector="Button.tile.indigo Border.iconbox PathIcon"><Setter Property="Foreground" Value="{StaticResource Brush.Brand}" /></Style>
  <Style Selector="Button.tile.violet Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.VioletIcon}" /></Style>
  <Style Selector="Button.tile.violet Border.iconbox PathIcon"><Setter Property="Foreground" Value="{StaticResource Brush.Violet}" /></Style>

  <!-- Open: can start now (early or late) -->
  <Style Selector="Button.tile.amber.open">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberBorder}" />
  </Style>
  <Style Selector="Button.tile.amber.open TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.AmberStrong}" /></Style>
  <Style Selector="Button.tile.amber.open Border.chip"><Setter Property="Background" Value="{StaticResource Brush.AmberSoft}" /></Style>
  <Style Selector="Button.tile.amber.open Border.chip > TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.AmberInk}" /></Style>
  <Style Selector="Button.tile.teal.open">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TealBorder}" />
  </Style>
  <Style Selector="Button.tile.teal.open TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.TealStrong}" /></Style>
  <Style Selector="Button.tile.teal.open Border.chip"><Setter Property="Background" Value="{StaticResource Brush.TealIcon}" /></Style>
  <Style Selector="Button.tile.teal.open Border.chip > TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.TealInk}" /></Style>

  <!-- Due: ringing, on time now -->
  <Style Selector="Button.tile.amber.due">
    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="BorderBrush" Value="#FCD9A0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="BorderBrush" Value="#F59E0B" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.tile.amber.due Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.Amber}" /></Style>
  <Style Selector="Button.tile.amber.due Border.iconbox PathIcon"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.tile.amber.due TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.AmberStrong}" /></Style>
  <Style Selector="Button.tile.amber.due Border.chip"><Setter Property="Background" Value="{StaticResource Brush.Amber}" /></Style>
  <Style Selector="Button.tile.amber.due Border.chip > TextBlock"><Setter Property="Foreground" Value="#2E1A02" /></Style>
  <Style Selector="Button.tile.teal.due">
    <Setter Property="Background" Value="{StaticResource Brush.TealBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Teal}" />
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="BorderBrush" Value="#A7E8DF" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="BorderBrush" Value="#14B8A6" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.tile.teal.due Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.Teal}" /></Style>
  <Style Selector="Button.tile.teal.due Border.iconbox PathIcon"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.tile.teal.due TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.TealStrong}" /></Style>
  <Style Selector="Button.tile.teal.due Border.chip"><Setter Property="Background" Value="{StaticResource Brush.Teal}" /></Style>
  <Style Selector="Button.tile.teal.due Border.chip > TextBlock"><Setter Property="Foreground" Value="#06302B" /></Style>

  <!-- Active: the current status -->
  <Style Selector="Button.tile.amber.active">
    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
  </Style>
  <Style Selector="Button.tile.amber.active Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.Amber}" /></Style>
  <Style Selector="Button.tile.amber.active Border.iconbox PathIcon"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.tile.amber.active TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.AmberStrong}" /></Style>
  <Style Selector="Button.tile.teal.active">
    <Setter Property="Background" Value="{StaticResource Brush.TealBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Teal}" />
  </Style>
  <Style Selector="Button.tile.teal.active Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.Teal}" /></Style>
  <Style Selector="Button.tile.teal.active Border.iconbox PathIcon"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.tile.teal.active TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.TealStrong}" /></Style>
  <Style Selector="Button.tile.indigo.active">
    <Setter Property="Background" Value="{StaticResource Brush.IndigoBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.tile.indigo.active Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.Brand}" /></Style>
  <Style Selector="Button.tile.indigo.active Border.iconbox PathIcon"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.tile.indigo.active TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.BrandPressed}" /></Style>
  <Style Selector="Button.tile.violet.active">
    <Setter Property="Background" Value="{StaticResource Brush.VioletBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Violet}" />
  </Style>
  <Style Selector="Button.tile.violet.active Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.Violet}" /></Style>
  <Style Selector="Button.tile.violet.active Border.iconbox PathIcon"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.tile.violet.active TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.VioletInk}" /></Style>
  <Style Selector="Button.tile.active">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Off: nothing to start here now; the caption says why. Stays readable. -->
  <Style Selector="Button.tile.off">
    <Setter Property="Background" Value="{StaticResource Brush.TileDisabledBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TileBorder}" />
  </Style>
  <Style Selector="Button.tile.off Border.iconbox"><Setter Property="Background" Value="{StaticResource Brush.NeutralBg}" /></Style>
  <Style Selector="Button.tile.off Border.iconbox PathIcon"><Setter Property="Foreground" Value="#9AA2B4" /></Style>
  <Style Selector="Button.tile.off TextBlock.tilevalue"><Setter Property="Foreground" Value="{StaticResource Brush.Muted}" /></Style>


  <!-- ===== Dialogs ================================================================== -->
  <Style Selector="Border.dialogfooter">
    <Setter Property="Background" Value="{StaticResource Brush.Footer}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,16,20,20" />
  </Style>
  <Style Selector="Border.dialogfooter UniformGrid > Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
  <Style Selector="TextBlock.count">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
  </Style>
  <Style Selector="TextBlock.count.ok">
    <Setter Property="Foreground" Value="{StaticResource Brush.GreenInk}" />
  </Style>

  <!-- ===== Break panel (replaces the tiles while on a break) ============================= -->
  <Style Selector="Border.breakpanel">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
  </Style>
  <Style Selector="Border.breakpanel TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#8A4B05" />
  </Style>
  <Style Selector="Border.breakpanel TextBlock.count">
    <Setter Property="FontSize" Value="56" />
    <Setter Property="LineHeight" Value="60" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{StaticResource Brush.AmberInk}" />
  </Style>
  <Style Selector="Border.breakpanel TextBlock.unit">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.AmberInk}" />
  </Style>
  <Style Selector="Border.breakpanel ProgressBar">
    <Setter Property="Foreground" Value="#D97706" />
    <Setter Property="Background" Value="{StaticResource Brush.AmberTrack}" />
  </Style>
  <Style Selector="Border.breakpanel.lunch">
    <Setter Property="Background" Value="{StaticResource Brush.TealBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Teal}" />
  </Style>
  <Style Selector="Border.breakpanel.lunch TextBlock.eyebrow, Border.breakpanel.lunch TextBlock.count, Border.breakpanel.lunch TextBlock.unit">
    <Setter Property="Foreground" Value="{StaticResource Brush.TealInk}" />
  </Style>
  <Style Selector="Border.breakpanel.lunch ProgressBar">
    <Setter Property="Foreground" Value="#0D9488" />
    <Setter Property="Background" Value="{StaticResource Brush.TealTrack}" />
  </Style>
  <Style Selector="Border.breakpanel.over">
    <Setter Property="Background" Value="{StaticResource Brush.RedBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Red}" />
  </Style>
  <Style Selector="Border.breakpanel.over TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{StaticResource Brush.RedDeep}" />
  </Style>
  <Style Selector="Border.breakpanel.over TextBlock.count, Border.breakpanel.over TextBlock.unit">
    <Setter Property="Foreground" Value="{StaticResource Brush.RedInk}" />
  </Style>
  <Style Selector="Border.breakpanel.over ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
    <Setter Property="Background" Value="{StaticResource Brush.RedTrack}" />
  </Style>

  <!-- ===== Today's breaks rows ====================================================== -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.row.hl">
    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberBorder}" />
  </Style>
  <Style Selector="TextBlock.small.alert">
    <Setter Property="Foreground" Value="{StaticResource Brush.RedInk}" />
  </Style>

  <!-- ===== Chat ===================================================================== -->
  <Style Selector="TextBox.chatinput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.chatinput:pointerover /template/ Border#PART_BorderElement, TextBox.chatinput:focus /template/ Border#PART_BorderElement, TextBox.chatinput:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Background" Value="{StaticResource Brush.Send}" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandHover}" />
  </Style>
  <Style Selector="Button.send:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>


  <!-- ===== Focus time (3.1: no activity score, no hourly bars) ============================== -->
  <Style Selector="TextBlock.focus">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="ProgressBar.focusbar">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Background" Value="#E7E9FE" />
  </Style>

  <!-- ===== Not started: the Start Day panel ============================================== -->
  <Style Selector="Border.startpanel">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Background" Value="{StaticResource Brush.IndigoBg}" />
    <Setter Property="BorderBrush" Value="#C7CBFA" />
  </Style>
  <Style Selector="Border.startpanel TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandPressed}" />
  </Style>
  <Style Selector="TextBlock.greeting">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.startday">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Background" Value="{StaticResource Brush.EndDay}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Height" Value="60" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.startday:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.EndDayHover}" />
  </Style>
  <Style Selector="Button.startday:pressed">
    <Setter Property="RenderTransform" Value="scale(0.99)" />
  </Style>
  <Style Selector="Button.startday:disabled">
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.startday TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.note">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Background" Value="{StaticResource Brush.NeutralBg}" />
  </Style>
  <Style Selector="Border.note TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
  </Style>
  <Style Selector="Border.note.warn">
    <Setter Property="Background" Value="{StaticResource Brush.AmberSoft}" />
  </Style>
  <Style Selector="Border.note.warn TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.AmberInk}" />
  </Style>

  <!-- ===== In a meeting: replaces the tiles ============================================== -->
  <Style Selector="Border.meetingpanel">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Background" Value="#F5F1FE" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Violet}" />
  </Style>
  <Style Selector="Border.meetingpanel TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.VioletInk}" />
  </Style>
  <Style Selector="Border.meetingpanel TextBlock.count">
    <Setter Property="FontSize" Value="46" />
    <Setter Property="LineHeight" Value="50" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="#4C1D95" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="0,0,-6,0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="#F5F1FE" />
    <Setter Property="Background" Value="{StaticResource Brush.Violet}" />
  </Style>
  <Style Selector="Border.avatar > TextBlock">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.meetingend">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Background" Value="#6D28D9" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Height" Value="46" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.meetingend TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.meetingend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.meetingend:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- ===== Dialog parts: chips, the skip button, tabs, people ============================= -->
  <Style Selector="Button.chip">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#D5D9E8" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.chip:pointerover">
    <Setter Property="BorderBrush" Value="#A99BF0" />
  </Style>
  <Style Selector="Button.chip.on">
    <Setter Property="Background" Value="{StaticResource Brush.VioletBg}" />
    <Setter Property="BorderBrush" Value="#7C3AED" />
    <Setter Property="Foreground" Value="{StaticResource Brush.VioletInk}" />
  </Style>
  <Style Selector="Button.chip:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.chip.small">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.chip.suggest">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderBrush" Value="#C4B5FD" />
    <Setter Property="Foreground" Value="{StaticResource Brush.VioletInk}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- "Skip break" and other second choices beside the primary button -->
  <Style Selector="Button.skip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#6D28D9" />
    <Setter Property="BorderBrush" Value="#D9CCF7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.skip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F7F3FE" />
    <Setter Property="BorderBrush" Value="#B9A5F2" />
    <Setter Property="Foreground" Value="#5B21B6" />
  </Style>
  <Style Selector="Button.plain">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0F000000" />
  </Style>

  <!-- Tabs: Starting now / Already happened -->
  <Style Selector="Border.tabs">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#EEF0F6" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
  </Style>
  <Style Selector="Button.tab.on">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.tab.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 1 3 0 #261E2233" />
  </Style>

  <!-- People in a meeting -->
  <Style Selector="Border.peoplebox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.FieldBorder}" />
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.person">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="4,0,2,0" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#F1F3F9" />
  </Style>
  <Style Selector="Border.personinitials">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Border.personinitials > TextBlock">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="#8A93A8" />
  </Style>
  <Style Selector="Border.range">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#F5F1FE" />
  </Style>
  <Style Selector="Border.range TextBlock">
    <Setter Property="Foreground" Value="#4C1D95" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.problem">
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Brush.RedBg}" />
  </Style>
  <Style Selector="Border.problem TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.RedInk}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.commentcard">
    <Setter Property="Padding" Value="12,11" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#E3E6EF" />
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.commentcard.compact">
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.commentcard.ok">
    <Setter Property="BorderBrush" Value="#C7C9F6" />
  </Style>

  <!-- ===== 4.0: quick-break lengths ================================================== -->
  <Style Selector="Button.minutes">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Height" Value="68" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TileBorder}" />
    <Setter Property="Background" Value="{StaticResource Brush.TileBg}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.minutes:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberBorder}" />
  </Style>
  <Style Selector="Button.minutes.on">
    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.AmberInk}" />
  </Style>

  <!-- ===== Lists ==================================================================== -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

</Styles>
