<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RXVision.Agent.ViewModels"
        xmlns:views="using:RXVision.Agent.Views"
        x:Class="RXVision.Agent.Views.BubbleWindow"
        x:DataType="vm:BubbleViewModel"
        Title="{Binding AccessibleName}"
        AutomationProperties.Name="{Binding AccessibleName}"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Width="72" Height="72">

  <Window.Styles>
    <Style Selector="MenuItem" x:DataType="vm:MenuItemViewModel">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="Command" Value="{Binding Command}" />
      <!-- 4.0: Quit is in the menu for admins only. -->
      <Setter Property="IsVisible" Value="{Binding IsVisible}" />
    </Style>
  </Window.Styles>

  <Grid Name="Root">
    <Grid.ContextMenu>
      <ContextMenu Name="BubbleMenu" ItemsSource="{Binding Menu.Items}" />
    </Grid.ContextMenu>
    <views:FloatingIconView Name="IconView" Cursor="Hand" AutomationProperties.Name="{Binding AccessibleName}" />
  </Grid>
</Window>
