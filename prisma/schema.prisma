generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 4.0: Super Admin (platform) -> Admin (one organisation) -> Manager (one or more
// departments) -> Staff (USER, one department). ADMIN was folded into MANAGER by
// 20261013 and returns in 4.0 with the organisation-admin meaning.
enum RoleName {
  SUPER_ADMIN
  MANAGER
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// A non-working presence status an employee can be in during the day.
// "Working" is the implicit default — it's simply the absence of an open session.
enum PresenceType {
  BREAK
  LUNCH
  MEETING
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  // Granted permission codes, stored inline (validated against the Permission enum in code).
  permissions String[] @default([])
  users       User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

/// An organisation (4.0). The table keeps its 2.x name.
model Company {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  users        User[]
  shifts       Shift[]
  departments  Department[]
  calendarDays CalendarDay[]
  signOutKeys  SignOutKey[]
  monthLocks   MonthLock[]
  reportRuns   ReportRun[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("companies")
}

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  name      String
  // "HH:MM" 24h window, judged against attendance. end <= start means the shift
  // runs past midnight.
  start     String
  end       String
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  users     User[]

  /// ISO weekdays the shift works (1 = Monday ... 7 = Sunday).
  workDays        Int[]   @default([1, 2, 3, 4, 5, 6]) @map("work_days")
  /// The shift used when neither the person nor their department has one.
  isDefault       Boolean @default(false) @map("is_default")
  /// The agent starts ringing this many minutes before each break...
  ringLeadMin     Int     @default(1) @map("ring_lead_min")
  /// ...and rings for this long. Starting a break while it rings is "on time".
  ringDurationMin Int     @default(5) @map("ring_duration_min")
  ringSound       Boolean @default(true) @map("ring_sound")
  /// Whether starting early (window open, before the ring) needs a reason.
  reasonOnEarly   Boolean @default(true) @map("reason_on_early")
  /// Whether starting late (after the ring, window still open) needs a reason.
  reasonOnLate    Boolean @default(true) @map("reason_on_late")
  reasonMinChars  Int     @default(10) @map("reason_min_chars")
  /// Also ask for a reason when someone comes back later than the grace allows.
  overrunReason   Boolean @default(false) @map("overrun_reason")
  /// Minutes over a break that are simply break time (no approval). 3.1 default 3.
  overrunGraceMin Int     @default(3) @map("overrun_grace_min")

  breaks       ShiftBreak[]
  assignments  ShiftAssignment[]
  breakRecords BreakRecord[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([companyId])
  @@map("shifts")
}

// The three daily breaks a shift can define.
enum BreakKind {
  MORNING
  LUNCH
  EVENING
  /// 4.0: a quick break, any time of the shift (5, 10 or 15 minutes planned).
  QUICK
}

/// 4.0: a break can be paused and resumed inside its window.
enum BreakState {
  ACTIVE
  PAUSED
  ENDED
}

/// 4.0 away (input) tracking: what became of a stretch with no keyboard or mouse input.
///   UNEXPLAINED   no reason given (End Day with the pop-up open, or not answered)
///   PENDING       a reason that needs approval to count as focus time
///   APPROVED / REJECTED  decided
///   NOT_REQUIRED  kept for history only
enum AwayStatus {
  UNEXPLAINED
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum SignOutScope {
  USERS
  DEPARTMENTS
  ORG
}

// How a break's start compares with its schedule.
//   ON_TIME         started while the agent was ringing
//   EARLY / LATE    started inside the allowed window but outside the ring
//   OUTSIDE_WINDOW  started outside the allowed window (only older agents can)
//   UNSCHEDULED     no matching scheduled break (older agents, or no shift)
enum BreakTiming {
  ON_TIME
  EARLY
  LATE
  OUTSIDE_WINDOW
  UNSCHEDULED
}

enum BreakApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ShiftAssignmentTarget {
  DEPARTMENT
  USER
}

/// One of a shift's breaks: when it is due, how long it lasts and the window in
/// which it may be started.
model ShiftBreak {
  id              String    @id @default(uuid()) @db.Uuid
  shiftId         String    @map("shift_id") @db.Uuid
  shift           Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  kind            BreakKind
  enabled         Boolean   @default(true)
  /// "HH:MM", local business time.
  startTime       String    @map("start_time")
  durationMin     Int       @map("duration_min")
  windowBeforeMin Int       @default(30) @map("window_before_min")
  windowAfterMin  Int       @default(60) @map("window_after_min")
  /// Whether staff may skip this break (3.1). The migration sets LUNCH rows to false.
  allowSkip       Boolean   @default(true) @map("allow_skip")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shiftId, kind])
  @@map("shift_breaks")
}

// What became of a scheduled break (3.1).
//   TAKEN         a break was taken (the 3.0 meaning of every record)
//   SKIPPED       the person pressed Skip break while the window was open
//   AUTO_SKIPPED  the window closed (or End Day ran inside it) with nothing taken
enum BreakOutcome {
  TAKEN
  SKIPPED
  AUTO_SKIPPED
}

enum MeetingMode {
  LIVE
  PAST
}

enum WorkSessionEndReason {
  USER
  AUTO_CLOSED
}

/// One stretch of a working day, Start Day to End Day (3.1). A day can hold several
/// (End Day then Start Day resumes). At most one is open per person: enforced by a
/// row lock on the user and by the partial unique index
/// work_sessions_one_open_per_user (migration SQL only; Prisma cannot express it).
model WorkSession {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Business-timezone day of startedAt. A session running past midnight keeps it.
  date      String
  startedAt DateTime              @map("started_at")
  endedAt   DateTime?             @map("ended_at")
  endReason WorkSessionEndReason? @map("end_reason")
  /// AGENT | LEGACY | BACKFILL
  source    String                @default("AGENT")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([endedAt])
  @@map("work_sessions")
}

/// A meeting a person reported (3.1): started live from the agent, or logged
/// afterwards. Counts as focus time; a rejection takes it off.
model MeetingRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  user              User                @relation("MeetingRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  date              String
  mode              MeetingMode
  agenda            String
  /// [{ "id"?: uuid, "name": string }]
  participants      Json                @default("[]")
  /// 4.0: who will mail the minutes of meeting (required from 4.0 agents).
  momSender         String?             @map("mom_sender")
  startedAt         DateTime            @map("started_at")
  endedAt           DateTime?           @map("ended_at")
  durationSec       Int?                @map("duration_sec")
  presenceSessionId String?             @unique @map("presence_session_id") @db.Uuid
  presenceSession   PresenceSession?    @relation(fields: [presenceSessionId], references: [id], onDelete: SetNull)
  approvalStatus    BreakApprovalStatus @default(PENDING) @map("approval_status")
  approverRole      RoleName?           @map("approver_role")
  approverId        String?             @map("approver_id") @db.Uuid
  decidedById       String?             @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?           @map("decided_at")
  decisionNote      String?             @map("decision_note")
  dueAt             DateTime?           @map("due_at")
  escalatedAt       DateTime?           @map("escalated_at")
  remindedAt        DateTime?           @map("reminded_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([approverId, approvalStatus, date])
  @@index([approverRole, approvalStatus, date])
  @@index([approvalStatus, dueAt])
  @@map("meeting_records")
}

/// Organisation settings (3.1), one JSON value per key. Key `org` holds the
/// Super Admin settings table (SPEC 1.10).
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// A monthly report built at 00:30 on the 1st for one owner (3.1).
model ReportRun {
  id          String   @id @default(uuid()) @db.Uuid
  /// 4.0: the organisation the run covers.
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month       String
  /// TEAM | ALL
  scope       String
  ownerId     String   @map("owner_id") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at")
  summary     Json

  @@unique([companyId, month, scope, ownerId])
  @@index([ownerId, month])
  @@map("report_runs")
}

/// A month closed for payroll (3.1): reports read the snapshot, decisions are refused.
/// 4.0: payroll month locks are per organisation.
model MonthLock {
  companyId  String   @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month      String
  lockedById String   @map("locked_by_id") @db.Uuid
  lockedAt   DateTime @default(now()) @map("locked_at")
  snapshot   Json

  @@id([companyId, month])
  @@map("month_locks")
}

/// Dated shift assignment. A person's shift on a given day is the newest USER row
/// in force that day, else their department's newest DEPARTMENT row, else the
/// default shift. Rows are never edited, only superseded, so history is kept.
model ShiftAssignment {
  id            String                @id @default(uuid()) @db.Uuid
  target        ShiftAssignmentTarget
  companyId     String?               @map("company_id") @db.Uuid
  /// Department as typed (for display) and its normalised key (for matching).
  department    String?
  departmentKey String?               @map("department_key")
  userId        String?               @map("user_id") @db.Uuid
  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null on a USER row means "back to the department's shift".
  shiftId       String?               @map("shift_id") @db.Uuid
  shift         Shift?                @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  /// Local day (YYYY-MM-DD) the assignment starts.
  effectiveFrom String                @map("effective_from")
  /// Optional last local day (inclusive). Only used on USER rows.
  effectiveTo   String?               @map("effective_to")
  createdById   String?               @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([target, departmentKey, effectiveFrom])
  @@index([userId, effectiveFrom])
  @@index([shiftId])
  @@map("shift_assignments")
}

/// A break that was actually taken, with a copy of the schedule it was judged
/// against (so later shift edits never rewrite history) and its approval trail.
/// End time and overrun come from the linked presence session.
model BreakRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  user              User                @relation("BreakRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Local day (YYYY-MM-DD) the break belongs to.
  date              String
  /// Null for an unscheduled break.
  kind              BreakKind?
  seq               Int                 @default(0)
  presenceType      PresenceType        @map("presence_type")
  shiftId           String?             @map("shift_id") @db.Uuid
  shift             Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftName         String?             @map("shift_name")
  scheduledStart    DateTime?           @map("scheduled_start")
  durationMin       Int?                @map("duration_min")
  windowOpen        DateTime?           @map("window_open")
  windowClose       DateTime?           @map("window_close")
  ringStart         DateTime?           @map("ring_start")
  ringEnd           DateTime?           @map("ring_end")
  presenceSessionId String?             @unique @map("presence_session_id") @db.Uuid
  presenceSession   PresenceSession?    @relation(fields: [presenceSessionId], references: [id], onDelete: SetNull)
  startedAt         DateTime            @map("started_at")
  timing            BreakTiming
  /// Minutes early or late against the scheduled start (always >= 0).
  minutesOff        Int                 @default(0) @map("minutes_off")
  reason            String?
  overrunReason     String?             @map("overrun_reason")
  /// AGENT (the break flow) or LEGACY (an older agent's plain break/lunch).
  source            String              @default("AGENT")
  approvalStatus    BreakApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  /// SUPER_ADMIN when routed to the Super Admin pool; else the approver's role.
  approverRole      RoleName?           @map("approver_role")
  approverId        String?             @map("approver_id") @db.Uuid
  decidedById       String?             @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?           @map("decided_at")
  decisionNote      String?             @map("decision_note")
  /// 3.1: TAKEN, or a skip (no presence session; startedAt = when it was skipped).
  outcome           BreakOutcome        @default(TAKEN)
  /// Seconds past the break's length, stored when the break ends through /breaks/end.
  overrunSec        Int?                @map("overrun_sec")
  /// The person asked their manager to count the overrun as focus time.
  overrunAsked      Boolean             @default(false) @map("overrun_asked")
  /// When the comment on an auto-skip was added (stored in `reason`).
  commentedAt       DateTime?           @map("commented_at")
  /// 48-hour rule: set every time the record becomes PENDING.
  dueAt             DateTime?           @map("due_at")
  escalatedAt       DateTime?           @map("escalated_at")
  remindedAt        DateTime?           @map("reminded_at")
  /// 4.0: ACTIVE / PAUSED / ENDED. Pre-4.0 rows are ENDED or have an open presence session.
  state             BreakState          @default(ENDED)
  /// 4.0 quick breaks: the planned length in minutes (5, 10 or 15 from the agent).
  plannedMin        Int?                @map("planned_min")
  /// 4.0: when the break was finally ended (segments may have stopped earlier).
  endedAt           DateTime?           @map("ended_at")
  /// 4.0: seconds taken over all segments, stored when the break ends.
  takenSec          Int?                @map("taken_sec")
  segments          BreakSegment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date, kind, seq])
  @@index([userId, date])
  @@index([approverId, approvalStatus, date])
  @@index([approverRole, approvalStatus, date])
  @@index([approvalStatus, date])
  @@index([approvalStatus, dueAt])
  @@map("break_records")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  // bcrypt hash (never the plaintext).
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  designation  String?
  department   String?
  status       UserStatus @default(ACTIVE)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  managerId String? @map("manager_id") @db.Uuid
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  shiftId    String? @map("shift_id") @db.Uuid
  shift      Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftStart String? @map("shift_start")
  shiftEnd   String? @map("shift_end")

  // First time this user's agent enrolled (installed & activated). Set once, then
  // used to notify their manager exactly once. Null = agent never activated yet.
  agentActivatedAt DateTime? @map("agent_activated_at")

  /// Whether this user's agent takes automatic screenshots. Turning it off stops
  /// only that periodic capture — activity tracking carries on, and a manager can
  /// still request a shot by hand. Defaults on, so existing users are unaffected.
  screenshotsEnabled Boolean @default(true) @map("screenshots_enabled")

  /// 4.0: the person's department (staff: required; managers: their own, optional).
  departmentId       String?             @map("department_id") @db.Uuid
  departmentRef      Department?         @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  /// 4.0 manager view grants, set by the organisation Admin.
  grantScreenshots   Boolean             @default(false) @map("grant_screenshots")
  grantTimeline      Boolean             @default(false) @map("grant_timeline")
  grantActivity      Boolean             @default(false) @map("grant_activity")
  /// 4.0 away tracking override: null = follow the department.
  idleEnabled        Boolean?            @map("idle_enabled")
  idleMinutes        Int?                @map("idle_minutes")
  /// 4.0: bumped by a key sign-out or a credential reset; installer tokens carry it.
  enrollVersion      Int                 @default(1) @map("enroll_version")
  managedDepartments ManagerDepartment[]
  awayEvents         AwayEvent[]

  refreshTokens    RefreshToken[]
  devices          Device[]
  dailyReports     DailyReport[]
  auditLogs        AuditLog[]
  presenceSessions PresenceSession[]
  onlineSessions   OnlineSession[]
  activitySamples  ActivitySample[]
  workDayEnds      WorkDayEnd[]
  shiftAssignments ShiftAssignment[]
  breakRecords     BreakRecord[]     @relation("BreakRecordUser")
  workSessions     WorkSession[]
  meetingRecords   MeetingRecord[]   @relation("MeetingRecordUser")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([roleId])
  @@index([managerId])
  @@index([department])
  @@index([status])
  @@index([companyId])
  @@index([departmentId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the issued refresh token (we never store the raw token).
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  // Link to the token that replaced this one (rotation chain).
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Device {
  id           String  @id @default(uuid()) @db.Uuid
  deviceToken  String? @map("device_token")
  hostname     String
  username     String
  displayName  String  @map("display_name")
  agentVersion String? @map("agent_version")

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  pairedAt DateTime @default(now()) @map("paired_at")
  lastSeen DateTime @default(now()) @map("last_seen")

  lastStats Json? @map("last_stats")

  reports     DailyReport[]
  screenshots Screenshot[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([lastSeen])
  @@map("devices")
}

model DailyReport {
  id       String  @id @default(uuid()) @db.Uuid
  date     String
  deviceId String? @map("device_id") @db.Uuid
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name     String
  hostname String?

  totalSec        Int @default(0) @map("total_sec")
  activeSec       Int @default(0) @map("active_sec")
  idleSec         Int @default(0) @map("idle_sec")
  productiveSec   Int @default(0) @map("productive_sec")
  extraSec        Int @default(0) @map("extra_sec")
  workingBasisSec Int @default(28800) @map("working_basis_sec")

  topApps     Json? @map("top_apps")
  topWebsites Json? @map("top_websites")
  hourly      Json?
  idleBlocks  Json? @map("idle_blocks")

  clockInMs  BigInt? @map("clock_in_ms")
  outMs      BigInt? @map("out_ms")
  clockedOut Boolean @default(false) @map("clocked_out")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, userId, deviceId])
  @@index([date])
  @@index([userId])
  @@map("daily_reports")
}

// Records that a user explicitly ended their working day (the "End Day" button).
// One row per user per local day. While no row exists for today, the agent keeps
// capturing screenshots (including overtime past the 9h basis and idle stretches);
// once the day is ended, capture stops for the rest of that local day.
model WorkDayEnd {
  id      String    @id @default(uuid()) @db.Uuid
  userId  String    @map("user_id") @db.Uuid
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Local calendar day (YYYY-MM-DD), server timezone — matches activity/presence.
  date    String
  // When the user logged into their PC (first logon of the day). Set on the first
  // activity report; earliest wins. Null until the agent reports a login.
  loginAt DateTime? @map("login_at")
  // When the user pressed "End Day". Null while the day is still open — a row can
  // exist for the login alone, so "day ended" means endedAt IS NOT NULL, not "row exists".
  endedAt DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("work_day_ends")
}

// A single stretch of time an employee spent on a break / lunch / meeting.
// Opening a session records `startedAt`; closing it fills `endedAt` + `durationSec`.
// An open session (endedAt = null) is the user's *current* status ("live").
// `date` is the local calendar day (YYYY-MM-DD) the session started, for day-wise rollups.
model PresenceSession {
  id       String       @id @default(uuid()) @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?      @map("device_id") @db.Uuid
  type     PresenceType
  // Optional note the employee sends the manager (used for MEETING sessions).
  note     String?
  date     String

  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationSec Int?      @map("duration_sec")

  breakRecord   BreakRecord?
  meetingRecord MeetingRecord?
  breakSegment  BreakSegment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([userId, endedAt])
  @@map("presence_sessions")
}

/// A stretch of "online" (working) time, driven by agent heartbeats. Each active
/// heartbeat extends `lastSeenAt`; a gap longer than the grace window (or an idle
/// signal) closes the session, so online time never counts idle or offline gaps.
model OnlineSession {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String? @map("device_id") @db.Uuid
  date     String

  startedAt   DateTime  @default(now()) @map("started_at")
  lastSeenAt  DateTime  @map("last_seen_at")
  endedAt     DateTime? @map("ended_at")
  durationSec Int?      @map("duration_sec")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, date])
  @@index([userId, endedAt])
  @@map("online_sessions")
}

/// One foreground-activity sample from the agent (≈ one per minute). Each sample
/// records the app/window/website that was in the foreground and whether the
/// machine was idle. `durationSec` is the time this sample's app stayed in the
/// foreground — it is filled in when the *next* sample arrives (the newest,
/// still-open sample carries 0 and is counted live up to "now" on read).
/// Rollups (top apps, top websites, active/idle seconds, hourly split, clock
/// in/out) are computed from these rows per local day.
model ActivitySample {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String? @map("device_id") @db.Uuid
  // Local calendar day (YYYY-MM-DD) the sample was taken, for day-wise rollups.
  date     String

  at          DateTime
  durationSec Int      @default(0) @map("duration_sec")
  idle        Boolean  @default(false)
  // Workstation was locked (Win+L / logged off / RDP disconnected). Always implies
  // `idle`, but flags inactivity that began at this instant rather than one idle
  // threshold earlier — so the rollup must not reclassify the work before it.
  locked      Boolean  @default(false)

  // Friendly application name, e.g. "Google Chrome" / "Visual Studio Code".
  app   String?
  // Foreground window title (best-effort).
  title String?
  // Website host when the foreground app is a browser, e.g. "github.com".
  // Host only (never the full path/query) to keep monitoring proportionate.
  url   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@index([userId, at])
  @@map("activity_samples")
}

// How a screenshot was triggered: the agent's 5-minute timer (AUTO) or a
// manager's on-demand "capture now" request (MANUAL).
enum ScreenshotKind {
  AUTO
  MANUAL
}

model Screenshot {
  id         String         @id @default(uuid()) @db.Uuid
  deviceId   String?        @map("device_id") @db.Uuid
  device     Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userId     String?        @map("user_id") @db.Uuid
  storageKey String         @map("storage_key")
  kind       ScreenshotKind @default(AUTO)
  takenAt    DateTime       @map("taken_at")
  // OCR text extracted on upload (AWS Textract), for full-text search.
  ocrText    String?        @map("ocr_text")
  // Set when a manager archives the shot; archived shots are hidden by default.
  archivedAt DateTime?      @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([deviceId])
  @@index([userId])
  @@index([takenAt])
  @@map("screenshots")
}

model ChatMessage {
  id         String    @id @default(uuid()) @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  body       String
  readAt     DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fromUserId])
  @@index([toUserId])
  @@map("chat_messages")
}

// How a screenshot was triggered: the 5-minute timer (AUTO) or a manager's
// on-demand "capture now" request (MANUAL).
enum PermissionRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model PermissionRequest {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  kind      String
  reason    String?
  status    PermissionRequestStatus @default(PENDING)
  decidedBy String?                 @map("decided_by") @db.Uuid
  decidedAt DateTime?               @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("permission_requests")
}

// ----------------------------------------------------------------------------
// Notifications
// ----------------------------------------------------------------------------
model Notification {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @map("user_id") @db.Uuid
  type   String
  title  String
  body   String?
  readAt DateTime? @map("read_at")

  /// Who caused it, when that is a person — the sender of a CHAT_MESSAGE, for
  /// instance. Lets a client open that person's conversation from the toast.
  /// Null for notifications that come from the system rather than a user.
  fromUserId String? @map("from_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  actorId  String? @map("actor_id") @db.Uuid
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String? @map("entity_id")
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 4.0: organisations, departments, away tracking, calendar, sign-out keys, offline
// ---------------------------------------------------------------------------

/// A department of an organisation. Staff belong to one; managers to one or more.
model Department {
  id        String              @id @default(uuid()) @db.Uuid
  companyId String              @map("company_id") @db.Uuid
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  /// Key from the themed icon set (docs/4.0/SPEC.md 7.6).
  icon      String              @default("briefcase")
  users     User[]              @relation("UserDepartment")
  managers  ManagerDepartment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([companyId])
  @@map("departments")
}

model ManagerDepartment {
  managerId    String     @map("manager_id") @db.Uuid
  manager      User       @relation(fields: [managerId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([managerId, departmentId])
  @@index([departmentId])
  @@map("manager_departments")
}

/// One stretch of a break (4.0 pause and resume). Each has its own presence session.
model BreakSegment {
  id                String           @id @default(uuid()) @db.Uuid
  breakRecordId     String           @map("break_record_id") @db.Uuid
  breakRecord       BreakRecord      @relation(fields: [breakRecordId], references: [id], onDelete: Cascade)
  presenceSessionId String?          @unique @map("presence_session_id") @db.Uuid
  presenceSession   PresenceSession? @relation(fields: [presenceSessionId], references: [id], onDelete: SetNull)
  startedAt         DateTime         @map("started_at")
  endedAt           DateTime?        @map("ended_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([breakRecordId])
  @@map("break_segments")
}

/// A stretch with no input, explained (or not) through the agent's away pop-up.
model AwayEvent {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String?    @map("company_id") @db.Uuid
  /// Shift-day (YYYY-MM-DD) the stretch belongs to.
  date         String
  startedAt    DateTime   @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  seconds      Int?
  reasonKey    String?    @map("reason_key")
  /// THINKING | MEETING | HARDWARE | OTHER | CUSTOM
  reasonKind   String?    @map("reason_kind")
  reasonLabel  String?    @map("reason_label")
  comment      String?
  /// [{ "id"?: uuid, "name": string }]
  participants Json       @default("[]")
  momSender    String?    @map("mom_sender")
  status       AwayStatus
  approverRole RoleName?  @map("approver_role")
  decidedById  String?    @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?  @map("decided_at")
  decisionNote String?    @map("decision_note")
  dueAt        DateTime?  @map("due_at")
  escalatedAt  DateTime?  @map("escalated_at")
  remindedAt   DateTime?  @map("reminded_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([companyId, status, date])
  @@index([status, dueAt])
  @@map("away_events")
}

/// A date whose working status differs from the organisation's week pattern (holidays,
/// extra working days).
model CalendarDay {
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        String
  isWorking   Boolean  @map("is_working")
  label       String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([companyId, date])
  @@map("calendar_days")
}

/// A 24-hour key an Admin issues so agents in its scope can sign out.
model SignOutKey {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phraseHash    String       @map("phrase_hash")
  salt          String
  scope         SignOutScope
  userIds       String[]     @default([]) @map("user_ids")
  departmentIds String[]     @default([]) @map("department_ids")
  createdById   String       @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  expiresAt     DateTime     @map("expires_at")
  revokedAt     DateTime?    @map("revoked_at")
  uses          Int          @default(0)

  @@index([companyId, expiresAt])
  @@map("sign_out_keys")
}

/// Offline replay idempotency: one row per agent event the server has applied.
model AgentEvent {
  userId        String   @map("user_id") @db.Uuid
  clientEventId String   @map("client_event_id") @db.Uuid
  kind          String
  eventAt       DateTime @map("event_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  status        Int
  body          Json

  @@id([userId, clientEventId])
  @@index([receivedAt])
  @@index([userId, eventAt])
  @@map("agent_events")
}
