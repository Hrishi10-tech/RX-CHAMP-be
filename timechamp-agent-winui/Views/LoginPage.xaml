<Page
    x:Class="TimeChampAgent.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:TimeChampAgent.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
        <h:InverseBoolConverter x:Key="NotBool" />
    </Page.Resources>

    <Grid Background="{StaticResource Bg}" Padding="32">
        <StackPanel VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Center" Spacing="4">
            <TextBlock Text="RX Vision" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
            <TextBlock Text="Sign in with the details your manager sent you"
                       Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,2,0,18" />

            <TextBlock Text="Work email" Foreground="{StaticResource Muted}" FontSize="12" />
            <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Margin="0,4,0,12" />

            <TextBlock Text="Password" Foreground="{StaticResource Muted}" FontSize="12" />
            <PasswordBox Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Margin="0,4,0,8" KeyDown="OnPasswordKeyDown" />

            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Foreground="#F87171" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <Button Content="{x:Bind ViewModel.SignInLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SignInCommand}"
                    IsEnabled="{x:Bind ViewModel.Busy, Mode=OneWay, Converter={StaticResource NotBool}}"
                    HorizontalAlignment="Stretch" Background="{StaticResource Brand}" Foreground="White"
                    BorderThickness="0" CornerRadius="8" Padding="14,10" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />

            <TextBlock Text="Your company uses RX Vision to record attendance and break time."
                       Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</Page>
