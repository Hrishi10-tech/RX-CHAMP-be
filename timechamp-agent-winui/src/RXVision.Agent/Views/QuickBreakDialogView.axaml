<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:RXVision.Agent.ViewModels.Dialogs"
             x:Class="RXVision.Agent.Views.QuickBreakDialogView"
             x:DataType="dlg:QuickBreakDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <!-- 4.0: a quick break of 5, 10 or 15 minutes, drawn as the 3.6 panel's dialogs. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,26,20,20" Spacing="12">
        <TextBlock Classes="h2" Text="{Binding Title}" />
        <TextBlock Classes="lead" Text="{Binding Message}" />
        <TextBlock Classes="label" Text="How long?" />
        <ItemsControl ItemsSource="{Binding Choices}" AutomationProperties.Name="How long">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dlg:MinutesChoiceViewModel">
              <Button Classes="chip" Classes.on="{Binding IsOn}" Command="{Binding PickCommand}" Margin="0,0,8,0" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Label}">
                <StackPanel HorizontalAlignment="Center" Spacing="0">
                  <TextBlock Text="{Binding Minutes}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="minutes" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="small" Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="dialogfooter">
      <Grid ColumnDefinitions="*,11,*">
        <Button Classes="secondary" HorizontalAlignment="Stretch" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Grid.Column="2" Name="Primary" Classes="primary" HorizontalAlignment="Stretch" Content="{Binding PrimaryText}" Command="{Binding SubmitCommand}" IsDefault="True" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
