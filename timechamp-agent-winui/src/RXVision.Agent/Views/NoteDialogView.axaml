<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:RXVision.Agent.ViewModels.Dialogs"
             x:Class="RXVision.Agent.Views.NoteDialogView"
             x:DataType="dlg:NoteDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,26,20,20" Spacing="10">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Classes="body" Text="{Binding Message}" />
      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="{Binding Label}" />
        <TextBox Name="NoteBox"
                 Classes="field"
                 Text="{Binding Text}"
                 Watermark="{Binding Placeholder}"
                 MaxLength="{Binding MaxLength}"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 Height="64"
                 VerticalContentAlignment="Top" />
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="dialogfooter">
      <StackPanel Spacing="10">
        <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding SkipText}" Command="{Binding SkipCommand}" IsVisible="{Binding HasSkip}" />
        <Grid ColumnDefinitions="*,11,*">
          <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
          <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Stretch" Content="{Binding PrimaryText}" Command="{Binding SubmitCommand}" IsDefault="True" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
