<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Text ===================================================================== -->
  <!-- Text colour is inherited from the window, so text inside buttons keeps the button's colour. -->
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="TextBlock.lead">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="TextBlock.small.attention">
    <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Why something did not go through: amber, the next step comes first in its words. -->
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.count">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="TextBlock.count.ok">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="TextBlock.greeting">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ===== Icons ==================================================================== -->
  <Style Selector="PathIcon.i">
    <Setter Property="Theme" Value="{StaticResource StrokeIcon}" />
  </Style>
  <Style Selector="PathIcon.spinner">
    <Setter Property="Theme" Value="{StaticResource StrokeIcon}" />
    <Setter Property="Data" Value="{StaticResource Icon.Spinner}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== The panel ================================================================ -->
  <Style Selector="Border.panelframe">
    <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="TextBlock.product">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="Button.paneltab">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="Button.paneltab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="Button.paneltab.on">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Brush.PanelBorder}" />
  </Style>
  <!-- The status line: a 10 px dot and the status in 15 px bold. -->
  <Style Selector="Ellipse.statusdot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.progressline">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- On a break: Paused, beside the held focus time -->
  <Style Selector="Border.pausedpill">
    <Setter Property="Background" Value="{StaticResource Brush.AmberWash}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,2" />
  </Style>
  <Style Selector="Border.pausedpill TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sofar">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- ===== Cards on top of Today ===================================================== -->
  <Style Selector="Border.alertcard">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,16,16,12" />
  </Style>
  <Style Selector="Border.iconcircle">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Brush.BrandWash}" />
  </Style>
  <Style Selector="Border.iconcircle PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Border.iconcircle.amber">
    <Setter Property="Background" Value="{StaticResource Brush.AmberWash}" />
  </Style>
  <Style Selector="Border.iconcircle.amber PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
  </Style>
  <Style Selector="Border.iconcircle.amber TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cardtitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.cardbody">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.banner.warn">
    <Setter Property="Background" Value="{StaticResource Brush.AmberWash}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberBorder}" />
  </Style>
  <Style Selector="Border.note">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
  </Style>
  <Style Selector="Border.note TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="Border.problem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource Brush.AmberWash}" />
  </Style>
  <Style Selector="Border.problem TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Now, on the current row of Today's breaks -->
  <Style Selector="Border.nowpill">
    <Setter Property="Height" Value="25" />
    <Setter Property="MinWidth" Value="45" />
    <Setter Property="CornerRadius" Value="12.5" />
    <Setter Property="Background" Value="#146FC9B6" />
    <Setter Property="BorderBrush" Value="#736FC9B6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.nowpill > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Today's breaks rows ====================================================== -->
  <Style Selector="Border.breakrow">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,8" />
  </Style>
  <Style Selector="TextBlock.rowname">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.rowname.current">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.rowright">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- ===== Buttons ================================================================== -->
  <Style Selector="Button">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.primary, Button.secondary, Button.soft">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- One filled button per screen -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandLabel}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandHover}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandLabel}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandPressed}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.BrandLabel}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Neutral}" />
  </Style>
  <!-- Outlined: a secondary action -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Neutral}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Disabled}" />
  </Style>
  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{StaticResource Brush.BrandWash}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandWashHover}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandWashHover}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <!-- A quiet text action: Skip this break, End day -->
  <Style Selector="Button.quiet">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="Button.quiet:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- Text links -->
  <Style Selector="Button.link">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.link:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- Small icon buttons (close, dismiss, back) -->
  <Style Selector="Button.ghost">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
  </Style>
  <Style Selector="Button.ghost PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <!-- A row of the Profile tab -->
  <Style Selector="Button.menuitem">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="4,11" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="Button.menuitem PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
  </Style>
  <!-- The account at the top of Profile: the whole row opens the avatar page -->
  <Style Selector="Button.menuitem.account">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,8" />
  </Style>
  <!-- Send, in Messages -->
  <Style Selector="Button.send">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.BrandHover}" />
  </Style>
  <Style Selector="Button.send:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ===== Inputs =================================================================== -->
  <Style Selector="TextBox.field">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="{StaticResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Neutral}" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark, TextBox.field /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{StaticResource Brush.Neutral}" />
  </Style>
  <Style Selector="TextBox.chatinput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.chatinput:pointerover /template/ Border#PART_BorderElement, TextBox.chatinput:focus /template/ Border#PART_BorderElement, TextBox.chatinput:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource Brush.Neutral}" />
  </Style>

  <!-- ===== Dialogs ================================================================== -->
  <!-- A card over the panel: Skip confirmation, Start confirmation and the rest. -->
  <Style Selector="Border.dialogcard">
    <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.dialogfooter">
    <Setter Property="Padding" Value="20,4,20,20" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.chip:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Neutral}" />
  </Style>
  <Style Selector="Button.chip.on">
    <Setter Property="Background" Value="{StaticResource Brush.BrandWash}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
  </Style>
  <Style Selector="Button.chip:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.chip.small">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.chip.suggest">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.commentcard">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
  </Style>
  <Style Selector="Border.commentcard.ok">
    <Setter Property="BorderBrush" Value="#736FC9B6" />
  </Style>
  <!-- Tabs: Starting now / Already happened -->
  <Style Selector="Border.tabs">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextQuiet}" />
  </Style>
  <Style Selector="Button.tab.on">
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>

  <!-- People in a meeting -->
  <Style Selector="Border.peoplebox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
    <Setter Property="Background" Value="{StaticResource Brush.Field}" />
  </Style>
  <Style Selector="Border.person">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="4,0,2,0" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="0,0,-6,0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Panel}" />
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
  </Style>
  <Style Selector="Border.avatar > TextBlock">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.range">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Brush.NeutralFill}" />
  </Style>
  <Style Selector="Border.range TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ===== Pages ==================================================================== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14" />
  </Style>
</Styles>
