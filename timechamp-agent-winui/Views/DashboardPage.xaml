<Page
    x:Class="TimeChampAgent.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TimeChampAgent.ViewModels"
    xmlns:h="using:TimeChampAgent.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <h:ActiveBrushConverter x:Key="ActiveBrush" />
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid x:Name="Root" Padding="16" Background="{StaticResource BgGradient}" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= FIRST CARD: status + time taken + end day ================= -->
        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="20" Padding="20">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Quick Status" Foreground="{StaticResource Text}" FontSize="16"
                           FontWeight="SemiBold" Margin="2,0,0,14" />

                <!-- 2x2 status tiles; the active one shows a live running timer.
                     Once the day has ended they dim and stop responding. -->
                <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12"
                      Opacity="{x:Bind ViewModel.TileOpacity, Mode=OneWay}"
                      IsHitTestVisible="{x:Bind ViewModel.TrackingEnabled, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Break (amber) -->
                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="16" Padding="15" BorderThickness="1.5" Tapped="OnBreakTapped"
                            Background="{x:Bind ViewModel.BreakActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#FEF6E9|#FBFCFE'}"
                            BorderBrush="{x:Bind ViewModel.BreakActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#F59E0B|#E6EBF2'}">
                        <StackPanel Spacing="9">
                            <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left"
                                    Background="{x:Bind ViewModel.BreakActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#F59E0B|#FBEACF'}">
                                <ic:SymbolIcon Symbol="DrinkCoffee" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{x:Bind ViewModel.BreakActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#FFFFFF|#F59E0B'}" />
                            </Border>
                            <TextBlock Text="Take a Break" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.BreakValue, Mode=OneWay}" Foreground="{x:Bind ViewModel.BreakValueBrush, Mode=OneWay}" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Lunch (teal) -->
                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="16" Padding="15" BorderThickness="1.5" Tapped="OnLunchTapped"
                            Background="{x:Bind ViewModel.LunchActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#E6FAF6|#FBFCFE'}"
                            BorderBrush="{x:Bind ViewModel.LunchActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#14B8A6|#E6EBF2'}">
                        <StackPanel Spacing="9">
                            <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left"
                                    Background="{x:Bind ViewModel.LunchActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#14B8A6|#CFF3EE'}">
                                <ic:SymbolIcon Symbol="Food" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{x:Bind ViewModel.LunchActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#FFFFFF|#14B8A6'}" />
                            </Border>
                            <TextBlock Text="Lunch" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.LunchValue, Mode=OneWay}" Foreground="{x:Bind ViewModel.LunchValueBrush, Mode=OneWay}" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Focus Work (indigo) — tap to return to work -->
                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="16" Padding="15" BorderThickness="1.5" Tapped="OnFocusTapped"
                            Background="{x:Bind ViewModel.FocusActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#EEF0FE|#F6F7FB'}"
                            BorderBrush="{x:Bind ViewModel.FocusActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#4F46E5|#E6EBF2'}">
                        <StackPanel Spacing="9">
                            <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left"
                                    Background="{x:Bind ViewModel.FocusActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#4F46E5|#D5D8FB'}">
                                <ic:SymbolIcon Symbol="Target" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{x:Bind ViewModel.FocusActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#FFFFFF|#4F46E5'}" />
                            </Border>
                            <TextBlock Text="Focus Work" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.FocusValue, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Meeting (violet) -->
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="16" Padding="15" BorderThickness="1.5" Tapped="OnMeetingTapped"
                            Background="{x:Bind ViewModel.MeetingActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#F1ECFD|#FBFCFE'}"
                            BorderBrush="{x:Bind ViewModel.MeetingActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#8B5CF6|#E6EBF2'}">
                        <StackPanel Spacing="9">
                            <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left"
                                    Background="{x:Bind ViewModel.MeetingActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#8B5CF6|#E7DEFB'}">
                                <ic:SymbolIcon Symbol="PeopleTeam" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{x:Bind ViewModel.MeetingActive, Mode=OneWay, Converter={StaticResource ActiveBrush}, ConverterParameter='#FFFFFF|#8B5CF6'}" />
                            </Border>
                            <TextBlock Text="Meeting" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.MeetingValue, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Time Taken Today -->
                <Border Grid.Row="2" Margin="0,14,0,0" Background="{StaticResource Card}" CornerRadius="16"
                        Padding="16,14" BorderBrush="{StaticResource Divider}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Time Taken Today" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:SymbolIcon Grid.Column="0" Symbol="DrinkCoffee" FontSize="17" VerticalAlignment="Center" Foreground="#F59E0B" />
                            <TextBlock Grid.Column="1" Text="Break" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.BreakTaken, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:SymbolIcon Grid.Column="0" Symbol="Food" FontSize="17" VerticalAlignment="Center" Foreground="#14B8A6" />
                            <TextBlock Grid.Column="1" Text="Lunch" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.LunchTaken, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:SymbolIcon Grid.Column="0" Symbol="PeopleTeam" FontSize="17" VerticalAlignment="Center" Foreground="#8B5CF6" />
                            <TextBlock Grid.Column="1" Text="Meeting" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.MeetingTaken, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Shown for the rest of the day once the user has signed off. -->
                <Border Grid.Row="3" VerticalAlignment="Top" Margin="0,14,0,0" CornerRadius="14"
                        Padding="14,12" Background="#EEF0FE" BorderBrush="#4F46E5" BorderThickness="1.5"
                        Visibility="{x:Bind ViewModel.DayEnded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#4F46E5" VerticalAlignment="Top">
                            <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="17" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" MaxWidth="230">
                            <TextBlock Text="Day ended" Foreground="#312E81" FontSize="13" FontWeight="Bold" />
                            <TextBlock Foreground="#4B5563" FontSize="11" TextWrapping="Wrap"
                                       Text="Tracking, screen captures and attendance have stopped. Today's hours are final — you can start again tomorrow." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Grid.Row="4" Command="{x:Bind ViewModel.EndDayCommand}"
                        IsEnabled="{x:Bind ViewModel.TrackingEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TrackingEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource EndDayButton}" Margin="0,14,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#33FFFFFF">
                            <ic:SymbolIcon Symbol="Power" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="END DAY" FontSize="14" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Finish &amp; save your session" FontSize="10" Foreground="#DAD8F5" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Grid Grid.Row="5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="14" Foreground="{StaticResource Green}" />
                        <TextBlock Text="{x:Bind ViewModel.SyncText, Mode=OneWay}"
                                   Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Command="{x:Bind ViewModel.SignOutCommand}" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="{StaticResource Brand}"
                            BorderThickness="0" Padding="8,4" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Sign out" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ic:SymbolIcon Symbol="ArrowExit" FontSize="13" Foreground="{StaticResource Brand}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= RIGHT: productivity on top, chat below ================= -->
        <Grid Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Today's Productivity (compact bar chart) -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="18" Padding="16">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <TextBlock Text="Today's Productivity" Foreground="{StaticResource Text}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Y axis -->
                        <Grid Grid.Column="0" Width="28" Height="92" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="100%" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="75%" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Text="50%" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="3" Text="25%" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="3" Text="0" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Plot -->
                        <Grid Grid.Column="1" Height="110">
                            <Grid Height="92" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="3" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,1" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ProductivityBars}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BarViewModel">
                                        <Grid Height="110" Margin="3,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Width="14" Height="{x:Bind Height}" CornerRadius="4,4,0,0"
                                                    Background="{x:Bind Fill}" Opacity="{x:Bind Opacity}" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind Label}" Foreground="{StaticResource Muted}"
                                                       FontSize="8" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Chat (under productivity, fills remaining height) -->
            <Border Grid.Row="1" Background="{StaticResource Chat}" CornerRadius="20">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,14">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource RowActive}">
                                <ic:SymbolIcon Symbol="Chat" FontSize="17" Foreground="{StaticResource Brand}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.ChatHeader, Mode=OneWay}" Foreground="{StaticResource Text}" FontSize="14"
                                       FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="0" Height="1" Background="{StaticResource Divider}" VerticalAlignment="Bottom" />

                    <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                    <Grid Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{x:Bind RowAlignment}" Spacing="8">
                                            <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top"
                                                    Background="{x:Bind AvatarBrush}" Visibility="{x:Bind AvatarVisibility}">
                                                <TextBlock Text="{x:Bind Initials}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Margin="0,0,0,3">
                                                    <Run Text="{x:Bind Sender}" FontWeight="SemiBold" Foreground="{StaticResource Text}" FontSize="12" />
                                                    <Run Text="{x:Bind Time}" Foreground="{StaticResource Muted}" FontSize="10" />
                                                </TextBlock>
                                                <Border Background="{x:Bind BubbleBrush}" CornerRadius="14" Padding="12,9" HorizontalAlignment="{x:Bind RowAlignment}">
                                                    <TextBlock Text="{x:Bind Body}" Foreground="{x:Bind BodyBrush}" FontSize="12" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="16,8,16,16" Background="{StaticResource InputField}" CornerRadius="24" Padding="6,4">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ChatInput" BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource InputInk}" FontSize="13" VerticalAlignment="Center"
                                     Padding="12,8" PlaceholderText="Message…"
                                     Text="{x:Bind ViewModel.ChatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnChatKeyDown" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.SendChatCommand}"
                                    Foreground="White" BorderThickness="0" Width="40" Height="40" Padding="0"
                                    CornerRadius="20" Background="{StaticResource BrandGradient}">
                                <ic:SymbolIcon Symbol="Send" FontSize="16" Foreground="White" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
