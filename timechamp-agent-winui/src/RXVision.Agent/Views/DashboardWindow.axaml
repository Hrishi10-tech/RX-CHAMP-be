<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RXVision.Agent.ViewModels"
        xmlns:views="using:RXVision.Agent.Views"
        xmlns:ctl="using:RXVision.Agent.Controls"
        xmlns:conv="using:RXVision.Agent.Converters"
        x:Class="RXVision.Agent.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Title="RX Vision"
        Icon="avares://RXVision/Assets/rxvision.ico"
        Width="1080" Height="700"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource Brush.WindowBg}">

  <Window.Resources>
    <!-- A quick-status tile. -->
    <DataTemplate x:Key="TileTemplate" x:DataType="vm:TileViewModel">
      <Button Theme="{StaticResource TileButton}"
              Classes="tile"
              Classes.amber="{Binding IsAmber}"
              Classes.teal="{Binding IsTeal}"
              Classes.indigo="{Binding IsIndigo}"
              Classes.violet="{Binding IsViolet}"
              Classes.open="{Binding IsOpen}"
              Classes.due="{Binding IsDue}"
              Classes.active="{Binding IsActive}"
              Classes.off="{Binding IsDisabled}"
              Command="{Binding Command}"
              ToolTip.Tip="{Binding ToolTip}"
              ToolTip.ShowOnDisabled="True"
              AutomationProperties.Name="{Binding Title}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="iconbox">
              <PathIcon Classes="i" Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
            </Border>
            <Border Grid.Column="1" Classes="chip" IsVisible="{Binding Chip, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Chip}" />
            </Border>
          </Grid>
          <TextBlock Grid.Row="1" Classes="tiletitle" Text="{Binding Title}" />
          <TextBlock Grid.Row="2" Classes="tilevalue" Text="{Binding Value}" />
          <TextBlock Grid.Row="3" Classes="tilecaption" Text="{Binding Caption}" />
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Panel>
    <Grid Name="Body" RowDefinitions="Auto,Auto,*" IsEnabled="{Binding !HasOverlay}">

      <!-- ===== Header: menu, who, status, day started, sync ===== -->
      <Grid Grid.Row="0" Margin="22,14,22,0" ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Name="MenuButton" Classes="burger" Classes.on="{Binding IsMenuOpen}" Command="{Binding ToggleMenuCommand}"
                Margin="0,0,12,0" VerticalAlignment="Center" ToolTip.Tip="Menu" AutomationProperties.Name="Menu">
          <PathIcon Classes="i" Data="{StaticResource Icon.Menu}" Width="18" Height="18" Foreground="{StaticResource Brush.InkSoft}" />
        </Button>
        <ctl:PersonAvatar Grid.Column="1" Name="HeaderAvatar" Width="40" Height="40" VerticalAlignment="Center" AvatarId="{Binding Profile.AvatarId}" />
        <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding DisplayName}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{Binding StatusKind, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
            <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.InkSoft}" />
            <TextBlock Classes="muted" Text="·" IsVisible="{Binding DayStartedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <PathIcon Classes="i" Data="{StaticResource Icon.Clock}" Width="13" Height="13" Foreground="{StaticResource Brush.Muted}"
                      IsVisible="{Binding DayStartedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted" Text="{Binding DayStartedText}" FontSize="12.5"
                       IsVisible="{Binding DayStartedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
            <PathIcon Classes="spinner" Width="14" Height="14" />
            <TextBlock Classes="muted" Text="Saving..." VerticalAlignment="Center" />
          </StackPanel>
          <Border Background="#FFFFFF" CornerRadius="14" Padding="11,6" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
                  ToolTip.Tip="{Binding SyncToolTip}"
                  IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding SyncTone, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
              <TextBlock Text="{Binding SyncText}" FontSize="12" Foreground="{StaticResource Brush.InkSoft}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ===== Banners ===== -->
      <StackPanel Grid.Row="1" Margin="22,0,22,0">
        <Border Classes="banner ended" Margin="0,12,0,0" IsVisible="{Binding IsDayEnded}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Brush.Brand}" VerticalAlignment="Center">
              <PathIcon Classes="i" Data="{StaticResource Icon.Check}" Foreground="#FFFFFF" Width="16" Height="16" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding EndedTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#312E81" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding EndedDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" Command="{Binding StartDayCommand}" VerticalAlignment="Center" IsVisible="{Binding ShowDayButtons}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Classes="i" Data="{StaticResource Icon.Play}" Foreground="#FFFFFF" Width="14" Height="14" />
                <TextBlock Text="Start Day" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- What the day view says about today (3.2 to 3.5): a day off, leave, work from home -->
        <Border Classes="banner info" Margin="0,12,0,0" IsVisible="{Binding DayOffText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="i" Data="{StaticResource Icon.Calendar}" Foreground="{StaticResource Brush.Brand}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DayOffText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="banner info" Margin="0,12,0,0" IsVisible="{Binding LeaveText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="i" Data="{StaticResource Icon.Calendar}" Foreground="{StaticResource Brush.Brand}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LeaveText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="banner info" Margin="0,12,0,0" IsVisible="{Binding WfhText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="i" Data="{StaticResource Icon.Home}" Foreground="{StaticResource Brush.Brand}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{Binding WfhText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="banner info" Margin="0,12,0,0" IsVisible="{Binding CheckoutMissingText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="i" Data="{StaticResource Icon.Calendar}" Foreground="{StaticResource Brush.Brand}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CheckoutMissingText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- A late start still waiting for its note (3.2) -->
        <Border Classes="banner warn" Margin="0,12,0,0" IsVisible="{Binding HasLateReason}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding LateReasonText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="primary" Margin="12,0,0,0" Content="Add a note" Command="{Binding AddLateReasonCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- An End Day done offline that waits for comments on skipped breaks -->
        <Border Classes="banner warn" Margin="0,12,0,0" IsVisible="{Binding HasHeldEndDay}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Classes="i" Data="{StaticResource Icon.Warning}" Foreground="{StaticResource Brush.AmberStrong}" Width="22" Height="22" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Your End Day needs comments" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.AmberInk}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding HeldEndDayText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" Content="Add comments" Command="{Binding EndDayCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="banner warn" Margin="0,12,0,0" IsVisible="{Binding ShowScreenRecordingBanner}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <PathIcon Classes="i" Data="{StaticResource Icon.Warning}" Foreground="{StaticResource Brush.AmberStrong}" Width="22" Height="22" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="RX Vision needs permission to take screenshots" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.AmberInk}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Turn on screen recording for RX Vision. After allowing it, quit and reopen RX Vision." TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" Content="Allow screen recording" Command="{Binding AllowScreenRecordingCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="ghost" Margin="8,0,0,0" Command="{Binding DismissScreenRecordingCommand}" ToolTip.Tip="Dismiss" VerticalAlignment="Center">
              <PathIcon Classes="i" Data="{StaticResource Icon.Close}" Width="14" Height="14" />
            </Button>
          </Grid>
        </Border>

        <Border Classes="banner info" Margin="0,12,0,0" IsVisible="{Binding HasUpdate}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <PathIcon Classes="i" Data="{StaticResource Icon.Download}" Foreground="{StaticResource Brush.Brand}" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="12,0,12,0" Text="{Binding UpdateText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="soft" Content="{Binding DownloadLabel}" Command="{Binding DownloadUpdateCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="ghost" Margin="8,0,0,0" Command="{Binding DismissUpdateCommand}" ToolTip.Tip="Dismiss" VerticalAlignment="Center">
              <PathIcon Classes="i" Data="{StaticResource Icon.Close}" Width="14" Height="14" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ===== History and Instructions (the hamburger menu) ===== -->
      <Panel Grid.Row="2" Margin="22,12,22,16" IsVisible="{Binding IsHistoryPage}">
        <views:HistoryView DataContext="{Binding History}" />
      </Panel>
      <Panel Grid.Row="2" Margin="22,12,22,16" IsVisible="{Binding IsLeavePage}">
        <views:LeaveView DataContext="{Binding Leave}" />
      </Panel>
      <Panel Grid.Row="2" Margin="22,12,22,16" IsVisible="{Binding IsCalendarPage}">
        <views:CalendarView DataContext="{Binding Calendar}" />
      </Panel>
      <Panel Grid.Row="2" Margin="22,12,22,16" IsVisible="{Binding IsInstructionsPage}">
        <views:InstructionsView DataContext="{Binding Instructions}" />
      </Panel>

      <!-- ===== Body ===== -->
      <Grid Grid.Row="2" Margin="22,12,22,16" ColumnDefinitions="352,*" IsVisible="{Binding IsDashboardPage}">

        <!-- Left: start day or quick status, today's breaks, end day -->
        <Border Classes="card" Padding="0" CornerRadius="20">
          <ScrollViewer Name="LeftScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto"
                  MinHeight="{Binding #LeftScroll.Bounds.Height, Converter={x:Static conv:OffsetConverter.Minus32}}">
              <StackPanel Grid.Row="0">
              <!-- The alerts (3.6): the break ring, a skipped break, the Start day nudge, notifications,
                   and the meeting cards (Start meeting?, End meeting?, Still in a meeting?, You're back to Working). -->
              <views:AlertCardsView Name="AlertCards" />
              <StackPanel Margin="2,0,2,12" Spacing="2" IsVisible="{Binding ShowProgress}">
                <TextBlock Name="ProgressLineText" Text="{Binding ProgressLine}" FontSize="15" FontWeight="Bold" />
                <TextBlock Classes="muted" Text="{Binding ProgressNote}" FontSize="13" IsVisible="{Binding ProgressNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Panel>
                <!-- Not started: the day begins with this button. -->
                <Border Classes="startpanel" IsVisible="{Binding IsNotStarted}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="YOUR DAY HASN'T STARTED" />
                    <TextBlock Classes="greeting" Text="{Binding GreetingText}" />
                    <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding ShiftLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <PathIcon Classes="i" Data="{StaticResource Icon.Calendar}" Width="14" Height="14" Foreground="{StaticResource Brush.Muted}" />
                      <TextBlock Classes="muted" FontSize="12.5" Text="{Binding ShiftLine}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Classes="startday" Command="{Binding StartDayCommand}" Margin="0,6,0,0"
                            IsVisible="{Binding ShowDayButtons}" AutomationProperties.Name="Start Day">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#33FFFFFF">
                          <PathIcon Classes="i" Data="{StaticResource Icon.Play}" Foreground="#FFFFFF" Width="16" Height="16" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Start Day" FontSize="17" FontWeight="Bold" />
                          <TextBlock Text="Focus time starts now" FontSize="11" Foreground="#DAD8F5" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                    <TextBlock Classes="body" FontSize="12.5" Text="Nothing is recorded until you press Start Day." IsVisible="{Binding ShowDayButtons}" />
                    <Border Classes="note" IsVisible="{Binding IsBiometric}">
                      <TextBlock Text="{Binding BiometricText}" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>
                    <Border Classes="note" IsVisible="{Binding DayCheckText, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding DayCheckText}" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>
                    <Border Classes="note" IsVisible="{Binding LastEndedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding LastEndedText}" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,10,Auto,Auto"
                      IsVisible="{Binding ShowTiles}" Opacity="{Binding TilesOpacity}">
                  <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding QuickTile}" ContentTemplate="{StaticResource TileTemplate}" />
                  <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding NextTile}" ContentTemplate="{StaticResource TileTemplate}" />
                  <ContentControl Grid.Row="2" Grid.Column="0" Content="{Binding FocusTile}" ContentTemplate="{StaticResource TileTemplate}" />
                  <ContentControl Grid.Row="2" Grid.Column="2" Content="{Binding MeetingTile}" ContentTemplate="{StaticResource TileTemplate}" />
                  <!-- The 4.0 meeting dialog: agenda, people and minutes (works offline), or an earlier meeting -->
                  <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Classes="link" Content="Meeting with details, or an earlier one"
                          Command="{Binding RecordMeetingCommand}" HorizontalAlignment="Right" Margin="0,8,2,0"
                          IsVisible="{Binding IsRunning}" AutomationProperties.Name="Meeting with details, or an earlier one" />
                </Grid>

                <!-- On a break: the countdown takes the tiles' place -->
                <Border Classes="breakpanel" IsVisible="{Binding IsOnBreak}"
                        Classes.lunch="{Binding ActiveBreak.IsLunch}"
                        Classes.over="{Binding ActiveBreak.IsOverrun}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="eyebrow" Text="{Binding ActiveBreak.Eyebrow}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" FontSize="12" Text="{Binding ActiveBreak.Started}" Foreground="{StaticResource Brush.InkSoft}" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="count" Text="{Binding ActiveBreak.Countdown}" />
                      <TextBlock Classes="unit" Text="{Binding ActiveBreak.Unit}" VerticalAlignment="Bottom" Margin="0,0,0,11" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveBreak.OverText}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Brush.RedInk}"
                               IsVisible="{Binding ActiveBreak.OverText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,-6,0,0" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ActiveBreak.Progress}"
                                 Height="8" MinHeight="8" CornerRadius="4"
                                 IsVisible="{Binding ActiveBreak.HasProgress}" />
                    <TextBlock Classes="body" FontSize="13" Text="{Binding ActiveBreak.Note}" />
                    <TextBlock Classes="small" Text="{Binding ActiveBreak.Approval}"
                               IsVisible="{Binding ActiveBreak.Approval, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                      <Button Classes="pause" Classes.lunch="{Binding ActiveBreak.IsLunch}"
                              Command="{Binding PauseBreakCommand}" IsVisible="{Binding ActiveBreak.CanPause}"
                              Width="112" Margin="0,0,10,0" AutomationProperties.Name="Pause break"
                              ToolTip.Tip="Pause: your focus time starts again. Resume before the break's window closes.">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <PathIcon Classes="i" Data="{StaticResource Icon.Pause}" Width="16" Height="16" />
                          <TextBlock Text="Pause" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Classes="back"
                              Classes.lunch="{Binding ActiveBreak.IsLunch}"
                              Classes.over="{Binding ActiveBreak.IsOverrun}"
                              Command="{Binding EndBreakCommand}"
                              AutomationProperties.Name="End break">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <PathIcon Classes="i" Data="{StaticResource Icon.Focus}" Foreground="#FFFFFF" Width="18" Height="18" />
                          <TextBlock Text="End break" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- In a meeting: its timer, agenda and people take the tiles' place -->
                <Border Classes="meetingpanel" IsVisible="{Binding IsInMeeting}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="eyebrow" Text="IN A MEETING" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" FontSize="12" Text="{Binding MeetingStarted}" Foreground="{StaticResource Brush.InkSoft}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="count" Text="{Binding MeetingTimer}" />
                    <TextBlock Text="{Binding MeetingAgenda}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding MeetingPeopleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <ItemsControl ItemsSource="{Binding MeetingPeople}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MeetingPersonViewModel">
                            <ctl:PersonAvatar Width="24" Height="24" Margin="0,0,-6,0" ToolTip.Tip="{Binding Name}" AvatarId="{Binding AvatarId}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Column="1" Classes="muted" Margin="14,0,0,0" Text="{Binding MeetingPeopleText}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Classes="small" Text="{Binding MeetingMomText}" IsVisible="{Binding MeetingMomText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="small" Text="Your focus time keeps counting in a meeting." />
                    <Button Classes="meetingend" Command="{Binding EndMeetingCommand}" Margin="0,4,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Classes="i" Data="{StaticResource Icon.Check}" Foreground="#FFFFFF" Width="17" Height="17" />
                        <TextBlock Text="End meeting" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Panel>
              </StackPanel>

              <!-- Today's breaks -->
              <Border Grid.Row="1" Classes="subcard" Margin="0,12,0,0" IsVisible="{Binding ShowBreakList}">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                    <TextBlock Classes="title" Text="Today's breaks" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="small" Text="{Binding ShiftText}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BreakRowViewModel">
                        <Border Classes="row" Classes.hl="{Binding IsHighlighted}" Margin="-8,0,-8,0">
                          <Grid ColumnDefinitions="24,*">
                            <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                              <PathIcon Classes="i" Data="{StaticResource Icon.Coffee}" Width="17" Height="17" Foreground="{StaticResource Brush.Amber}" IsVisible="{Binding !IsLunch}" HorizontalAlignment="Left" />
                              <PathIcon Classes="i" Data="{StaticResource Icon.Lunch}" Width="17" Height="17" Foreground="{StaticResource Brush.Teal}" IsVisible="{Binding IsLunch}" HorizontalAlignment="Left" />
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="2">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                                  <Border Classes="pill" Background="{Binding PillTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}">
                                    <TextBlock Text="{Binding PillText}" Foreground="{Binding PillTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
                                  </Border>
                                  <Border Classes="pill" Background="{Binding ApprovalTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}"
                                          IsVisible="{Binding ApprovalText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding ApprovalText}" Foreground="{Binding ApprovalTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
                                  </Border>
                                </StackPanel>
                              </Grid>
                              <TextBlock Classes="small" Classes.alert="{Binding DetailIsAlert}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Detail}" />
                              <TextBlock Classes="small" Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic"
                                         IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                              <Button Classes="link" Content="Add comment" Command="{Binding CommentCommand}" HorizontalAlignment="Left"
                                      Margin="0,2,0,2" IsVisible="{Binding CanComment}" AutomationProperties.Name="Add comment" />
                              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,2" IsVisible="{Binding HasActions}">
                                <Button Classes="rowaction" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" AutomationProperties.Name="Resume break">
                                  <TextBlock Text="Resume" />
                                </Button>
                                <Button Classes="rowaction quiet" Command="{Binding EndCommand}" IsVisible="{Binding CanEnd}" AutomationProperties.Name="End break">
                                  <TextBlock Text="End break" />
                                </Button>
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" Text="{Binding FreeText}" TextWrapping="Wrap" IsVisible="{Binding ShowFreeText}" LineHeight="18" />
                </StackPanel>
              </Border>

              <!-- End day -->
              <Button Grid.Row="3" Classes="endday" Command="{Binding EndDayCommand}" Margin="0,12,0,0">
                <Button.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsRunning" />
                    <Binding Path="ShowDayButtons" />
                  </MultiBinding>
                </Button.IsVisible>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Width="30" Height="30" CornerRadius="15" Background="#33FFFFFF">
                    <PathIcon Classes="i" Data="{StaticResource Icon.Power}" Foreground="#FFFFFF" Width="16" Height="16" />
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="END DAY" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="Finish and save your day" FontSize="10.5" Foreground="#DAD8F5" />
                  </StackPanel>
                </StackPanel>
              </Button>
            </Grid>
          </ScrollViewer>
        </Border>

        <!-- Right: today, chat -->
        <Grid Grid.Column="1" Margin="14,0,0,0" RowDefinitions="Auto,*">
          <Border Classes="card" Padding="18,14,18,14">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title" FontSize="14" Text="Today" />
                <TextBlock Grid.Column="1" Classes="small" Text="Focus time runs from Start Day, minus breaks" VerticalAlignment="Center" />
              </Grid>

              <!-- Focus time: the server's number, ticking while the day runs -->
              <Grid ColumnDefinitions="Auto,*">
                <StackPanel Spacing="1" VerticalAlignment="Bottom">
                  <TextBlock Classes="small" FontSize="11.5" Text="Focus time" />
                  <TextBlock Classes="focus num" Text="{Binding Today.FocusText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,6" Spacing="6" VerticalAlignment="Bottom">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="small" FontSize="11.5" Text="{Binding Today.FocusStatus}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="small" FontSize="11.5" Text="{Binding Today.ExpectedText}" Margin="8,0,0,0" />
                  </Grid>
                  <ProgressBar Classes="focusbar" Minimum="0" Maximum="1" Value="{Binding Today.Progress}" Height="8" MinHeight="8" CornerRadius="4" />
                </StackPanel>
              </Grid>
              <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0" VerticalAlignment="Center"
                            IsVisible="{Binding Today.DayStartedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <PathIcon Classes="i" Data="{StaticResource Icon.Clock}" Width="13" Height="13" Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Classes="muted" Text="{Binding Today.DayStartedText}" />
                </StackPanel>
                <Border Classes="pill" Background="{StaticResource Brush.GreenBg}" Margin="0,0,8,0" IsVisible="{Binding Today.HasPlus}">
                  <TextBlock Text="{Binding Today.PlusText}" Foreground="{StaticResource Brush.GreenInk}" />
                </Border>
                <Border Classes="pill" Background="{StaticResource Brush.NeutralBg}" IsVisible="{Binding Today.HasMinus}">
                  <TextBlock Text="{Binding Today.MinusText}" Foreground="{StaticResource Brush.Neutral}" />
                </Border>
                <Border Classes="pill" Background="{StaticResource Brush.NeutralBg}" Margin="8,0,0,0" IsVisible="{Binding Today.HasAdjusted}" ToolTip.Tip="Changed by hand by the Super Manager; the reason is in your notifications">
                  <TextBlock Text="{Binding Today.AdjustedText}" Foreground="{StaticResource Brush.Neutral}" />
                </Border>
              </WrapPanel>

              <!-- The paid break allowance (SPEC 2.4, 8.1), and paid time beside it: focus + paid breaks -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Classes="i" Data="{StaticResource Icon.Coffee}" Width="14" Height="14" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center"
                          Margin="0,0,7,0" Background="Transparent" ToolTip.Tip="{Binding Today.AllowanceToolTip}" />
                <TextBlock Grid.Column="1" Classes="small" Classes.alert="{Binding Today.HasUnpaid}" FontSize="12" Text="{Binding Today.AllowanceText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Today.AllowanceToolTip}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center" Background="Transparent"
                            IsVisible="{Binding Today.HasPaidTime}" ToolTip.Tip="{x:Static vm:TodayViewModel.PaidTimeToolTip}">
                  <TextBlock Classes="small" FontSize="12" Text="Paid time" VerticalAlignment="Center" />
                  <TextBlock Classes="num" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Today.PaidTimeText}" VerticalAlignment="Center"
                             Foreground="{StaticResource Brush.Ink}" />
                </StackPanel>
              </Grid>

              <!-- Offline time the server has no activity data for yet (SPEC 2.4): only when there is some -->
              <Border Classes="note warn" Padding="10,7" IsVisible="{Binding Today.HasUnverified}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                  <PathIcon Classes="i" Data="{StaticResource Icon.CloudOff}" Width="14" Height="14" Foreground="{StaticResource Brush.AmberStrong}"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Text="Offline, no activity data" />
                    <TextBlock Classes="num" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Today.UnverifiedText}" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                             Text="{x:Static vm:TodayViewModel.UnverifiedNote}" />
                </Grid>
              </Border>

              <Border Padding="0,9,0,0" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,*,*">
                  <TextBlock Classes="title" Text="Time taken today" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                    <PathIcon Classes="i" Data="{StaticResource Icon.Coffee}" Width="16" Height="16" Foreground="{StaticResource Brush.Amber}" />
                    <TextBlock Classes="muted" Text="Break" VerticalAlignment="Center" />
                    <TextBlock Classes="num" Text="{Binding Today.BreakTotal}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                    <PathIcon Classes="i" Data="{StaticResource Icon.Lunch}" Width="16" Height="16" Foreground="{StaticResource Brush.Teal}" />
                    <TextBlock Classes="muted" Text="Lunch" VerticalAlignment="Center" />
                    <TextBlock Classes="num" Text="{Binding Today.LunchTotal}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7">
                    <PathIcon Classes="i" Data="{StaticResource Icon.Meeting}" Width="16" Height="16" Foreground="{StaticResource Brush.Violet}" />
                    <TextBlock Classes="muted" Text="Meeting" VerticalAlignment="Center" />
                    <TextBlock Classes="num" Text="{Binding Today.MeetingTotal}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Waiting for your manager -->
              <Border Padding="0,9,0,0" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" IsVisible="{Binding Today.HasWaiting}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" FontSize="12.5" Text="{Binding Today.WaitingTitle}" />
                  <ItemsControl ItemsSource="{Binding Today.Waiting}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WaitingItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,5" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                   Fill="{Binding Kind, Converter={x:Static conv:WaitingDotConverter.Instance}}" />
                          <TextBlock Grid.Column="1" Margin="8,0,10,0" Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource Brush.InkSoft}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Classes="pill" Background="{Binding ChipTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}">
                            <TextBlock Text="{Binding Chip}" Foreground="{Binding ChipTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="small" Text="{Binding Today.WaitingMore}" IsVisible="{Binding Today.WaitingMore, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <views:ChatView Grid.Row="1" Margin="0,14,0,0" DataContext="{Binding Chat}" />
        </Grid>
      </Grid>
    </Grid>

    <!-- ===== The hamburger menu: pages, sign out, quit (admins) ===== -->
    <Panel IsVisible="{Binding IsMenuOpen}">
      <Button Theme="{StaticResource BareButton}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Command="{Binding CloseMenuCommand}" AutomationProperties.Name="Close menu" />
      <Border Name="MainMenu" Classes="menu" Width="244" Margin="22,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Spacing="2">
          <!-- Profile (3.6): the account row opens the avatar picker -->
          <views:ProfileView DataContext="{Binding Profile}" />
          <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="8,4" />
          <Button Classes="menuitem" Classes.on="{Binding IsDashboardPage}" Command="{Binding ShowDashboardCommand}" AutomationProperties.Name="Dashboard">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Classes="i" Data="{StaticResource Icon.Home}" Width="17" Height="17" />
              <TextBlock Text="Dashboard" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="menuitem" Classes.on="{Binding IsHistoryPage}" Command="{Binding ShowHistoryCommand}" AutomationProperties.Name="History">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Classes="i" Data="{StaticResource Icon.History}" Width="17" Height="17" />
              <TextBlock Text="History" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="menuitem" Classes.on="{Binding IsLeavePage}" Command="{Binding ShowLeaveCommand}" AutomationProperties.Name="Leave">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Classes="i" Data="{StaticResource Icon.Coffee}" Width="17" Height="17" />
              <TextBlock Text="Leave" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="menuitem" Classes.on="{Binding IsCalendarPage}" Command="{Binding ShowCalendarCommand}" AutomationProperties.Name="My calendar">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Classes="i" Data="{StaticResource Icon.Calendar}" Width="17" Height="17" />
              <TextBlock Text="My calendar" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="menuitem" Classes.on="{Binding IsInstructionsPage}" Command="{Binding ShowInstructionsCommand}" AutomationProperties.Name="Instructions">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Classes="i" Data="{StaticResource Icon.Book}" Width="17" Height="17" />
              <TextBlock Text="Instructions" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="8,4" />
          <Button Classes="menuitem" Command="{Binding SignOutCommand}" AutomationProperties.Name="Sign out">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Classes="i" Data="{StaticResource Icon.SignOut}" Width="17" Height="17" />
              <StackPanel Spacing="1">
                <TextBlock Text="Sign out…" />
                <TextBlock Classes="small" FontSize="11" Text="Needs a key from your admin" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="menuitem quit" Command="{Binding QuitCommand}" IsVisible="{Binding CanQuit}" AutomationProperties.Name="Quit RX Vision">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Classes="i" Data="{StaticResource Icon.Power}" Width="17" Height="17" />
              <TextBlock Text="Quit RX Vision…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Panel>

    <!-- ===== Dialogs: over the dashboard, which waits behind a scrim ===== -->
    <Panel IsVisible="{Binding HasOverlay}" Background="{StaticResource Brush.Scrim}">
      <Border Background="#FFFFFF" CornerRadius="12" Width="{Binding OverlayWidth}" Margin="20"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 24 60 0 #59141828" ClipToBounds="True">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ContentControl Content="{Binding Overlay}" />
        </ScrollViewer>
      </Border>
    </Panel>
  </Panel>
</Window>
