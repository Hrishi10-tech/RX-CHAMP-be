<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:RXVision.Agent.ViewModels.Dialogs"
             xmlns:conv="using:RXVision.Agent.Converters"
             x:Class="RXVision.Agent.Views.ReasonDialogView"
             x:DataType="dlg:ReasonDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <StackPanel>
    <StackPanel Margin="24,22,24,18" Spacing="12">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <WrapPanel IsVisible="{Binding HasTag}">
        <Border Classes="pill" Background="{Binding TagTone, Converter={x:Static conv:ToneBackgroundConverter.Instance}}" Margin="0,0,8,0">
          <TextBlock Text="{Binding TagText}" Foreground="{Binding TagTone, Converter={x:Static conv:ToneForegroundConverter.Instance}}" />
        </Border>
        <TextBlock Classes="muted" Text="{Binding TagDetail}" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Classes="body" Text="{Binding Message}" />
      <ItemsControl Name="ChipList" ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" AutomationProperties.Name="Quick reasons">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dlg:ChipViewModel">
            <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" Margin="0,0,8,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="6" Margin="0,2,0,0">
        <TextBlock Classes="label" Text="{Binding Label}" />
        <TextBox Name="ReasonBox"
                 Classes="field"
                 Text="{Binding Text}"
                 Watermark="{Binding Placeholder}"
                 MaxLength="{Binding MaxLength}"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 Height="84"
                 VerticalContentAlignment="Top" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="small" Text="{Binding Hint}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Classes="count" Classes.ok="{Binding CountOk}" Text="{Binding CountText}" Margin="12,0,0,0" />
        </Grid>
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </StackPanel>
    <Border Classes="dialogfooter">
      <Panel>
        <UniformGrid Rows="1" Margin="-4,0" IsVisible="{Binding HasNoAlt}">
          <Button Classes="primary"
                  Content="{Binding PrimaryText}"
                  Command="{Binding SubmitCommand}"
                  IsDefault="{Binding HasNoAlt}" />
          <Button Classes="secondary"
                  Content="{Binding CancelText}"
                  Command="{Binding CancelCommand}"
                  IsCancel="True" />
        </UniformGrid>
        <!-- Start break · Skip break · Cancel, or Ask manager · Leave them out · Stay on break -->
        <Grid ColumnDefinitions="1.2*,8,*,8,Auto" IsVisible="{Binding HasAlt}">
          <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding PrimaryText}"
                  Command="{Binding SubmitCommand}" IsDefault="{Binding HasAlt}" />
          <Button Grid.Column="2" Classes="skip" HorizontalAlignment="Stretch" Content="{Binding AltText}"
                  Command="{Binding AlternativeCommand}" />
          <Button Grid.Column="4" Classes="plain" Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
        </Grid>
      </Panel>
    </Border>
  </StackPanel>
</UserControl>
