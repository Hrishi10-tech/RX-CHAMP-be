<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:RXVision.Agent.ViewModels.Dialogs"
             x:Class="RXVision.Agent.Views.KeyDialogView"
             x:DataType="dlg:KeyDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <!-- 4.0: a sign-out or quit key from the admin, drawn as the 3.6 panel's dialogs. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,26,20,20" Spacing="10">
        <TextBlock Classes="h2" Text="{Binding Title}" />
        <TextBlock Classes="lead" Text="{Binding Message}" />
        <StackPanel Spacing="6" Margin="0,4,0,0">
          <TextBlock Classes="label" Text="Sign-out key" />
          <TextBox Name="KeyBox" Classes="field" Text="{Binding Key}" Watermark="five words and a number" MaxLength="120"
                   AutomationProperties.Name="Sign-out key" />
          <TextBlock Classes="small" Text="{Binding Hint}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="dialogfooter">
      <Grid ColumnDefinitions="*,11,*">
        <Button Classes="secondary" HorizontalAlignment="Stretch" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Stretch" Content="{Binding PrimaryText}" Command="{Binding SubmitCommand}" IsDefault="True" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
