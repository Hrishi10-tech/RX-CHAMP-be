<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:RXVision.Agent.ViewModels.Dialogs"
             x:Class="RXVision.Agent.Views.EndDayDialogView"
             x:DataType="dlg:EndDayDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Margin="20,26,20,10" Spacing="10">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Classes="body" Text="{Binding Message}" />
    </StackPanel>
    <!-- The boxes scroll on their own, so the words and End day stay on the panel. -->
    <ScrollViewer Grid.Row="1" Name="CommentList" Margin="20,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dlg:SkipCommentItemViewModel">
              <Border Classes="commentcard" Classes.ok="{Binding CountOk}" Margin="0,0,0,8"
                      AutomationProperties.Name="{Binding Name}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*">
                    <Panel Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,8,0">
                      <PathIcon Classes="i" Data="{StaticResource Icon.Coffee}" Width="16" Height="16" Foreground="{StaticResource Brush.Amber}" IsVisible="{Binding !IsLunch}" />
                      <PathIcon Classes="i" Data="{StaticResource Icon.Lunch}" Width="16" Height="16" Foreground="{StaticResource Brush.Brand}" IsVisible="{Binding IsLunch}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Classes="title" Text="{Binding Name}" />
                      <TextBlock Classes="small" Text="{Binding When}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Chips}" AutomationProperties.Name="Quick reasons">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dlg:ChipViewModel">
                        <Button Classes="chip small" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" Margin="0,0,6,6" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Classes="field"
                           Text="{Binding Text}"
                           Watermark="Why was this break skipped?"
                           MaxLength="{Binding MaxLength}"
                           TextWrapping="Wrap"
                           AcceptsReturn="False"
                           MinHeight="38"
                           MaxHeight="76"
                           VerticalContentAlignment="Top"
                           AutomationProperties.Name="{Binding BoxLabel}" />
                  <TextBlock Classes="count" Classes.ok="{Binding CountOk}" Text="{Binding Help}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="20,6,20,14" Spacing="8">
      <TextBlock Classes="small" Text="{Binding Note}" TextWrapping="Wrap" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <Border Grid.Row="3" Classes="dialogfooter">
      <Grid ColumnDefinitions="*,11,*">
        <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding CancelText}"
                Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Stretch" Content="{Binding PrimaryText}" Command="{Binding SubmitCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
